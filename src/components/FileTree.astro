---
/*
  The home page: the site as a literal file tree, shaped like a family tree and
  painted in watercolour (the look is after the game Gris: soft washes on warm
  paper, thin flowing coral stems, candelabra twigs tipped with square buds,
  big translucent geometric canopies). The tree, its shapes and its colours are
  our own; nothing is copied from the game.

  It starts as a planted terracotta pot. Clicking the pot grows a full-grown
  trunk that forks. Every item in a folder gets its own limb fanning out from
  that fork: folders climb up the middle and bloom into canopies, pages spread
  to the sides and end in square buds. It grows outward as people open folders.

  Motion (from Finn Taylor's "Literal file tree", DESIGN-BRIEF.md "The tree"):
  - a limb grows in ~0.85s, fast then slowing; canopies bloom open as it arrives
  - opening a folder pans the view ~0.65s to fit the new level, at the same time
  - older levels fade back as you go deeper; closing pulls limbs back in ~0.4s
*/
import { tree } from '../data/tree';
// The nested list below holds every page, shown if JavaScript is off.
---

<div class="tree-root" data-tree>
  <canvas class="tree-bg" aria-hidden="true"></canvas>
  <canvas class="tree-canvas" aria-hidden="true"></canvas>
  <canvas class="tree-grain" aria-hidden="true"></canvas>
  <div class="tree-world" data-world></div>

  <nav class="tree-list" aria-label="Pages">
    <ul>
      {tree.children!.map((a) => (
        <li>
          {a.kind === 'file' ? <a href={a.href}>{a.name}</a> : <span>{a.name}/</span>}
          {a.children && (
            <ul>
              {a.children.map((b) => (
                <li>
                  {b.kind === 'file' ? <a href={b.href}>{b.name}</a> : <span>{b.name}/</span>}
                  {b.children && (
                    <ul>
                      {b.children.map((c) => (
                        <li><a href={c.href}>{c.name}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</div>

<script type="application/json" id="tree-data" set:html={JSON.stringify(tree)} />

<style is:global>
  .tree-root { position: fixed; inset: 0; overflow: hidden; background: var(--color-paper); }
  .tree-bg, .tree-canvas, .tree-grain { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  /* paper grain sits over the paint, so washes pick up the texture of the paper */
  .tree-grain { mix-blend-mode: multiply; opacity: 0.5; }
  .tree-world { position: absolute; left: 0; top: 0; will-change: transform; }

  /* Every page as a plain list, for when JavaScript is off. With it on, the tree's own
     links and folder buttons (with aria-expanded) do the job, so the list steps aside. */
  .tree-list { position: relative; padding: 96px 24px; font-size: var(--text-base); line-height: 2; }
  html.js .tree-list { display: none; }
  html:not(.js) .tree-list ul ul { padding-left: 1.25rem; }

  .pot-btn { position: absolute; padding: 0; background: none; border: 0; border-radius: 24px; cursor: pointer; }

  /* A node sits exactly on a limb's tip. Its hit area covers the painted bud or canopy;
     its label sits wherever it's clear of the tree. */
  .tnode {
    position: absolute;
    width: 2px;
    height: 2px;
    margin: -1px 0 0 -1px;
    padding: 0;
    font: inherit;
    font-size: 12.5px;
    line-height: 1;
    color: var(--color-quiet);
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.35s ease, color 0.15s ease;
    pointer-events: none;
  }
  .tnode .hit { position: absolute; translate: -50% -50%; border-radius: 22%; }
  .tnode .label {
    position: absolute;
    white-space: nowrap;
    padding: 4px 2px;
    translate: 0 -50%;
    text-shadow: 0 0 3px var(--color-paper), 0 0 3px var(--color-paper), 0 0 8px var(--color-paper);
  }
  .tnode.read-left .label { translate: -100% -50%; }
  .tnode.read-centre .label { translate: -50% -50%; }
  .tnode.shown { opacity: 1; pointer-events: auto; }
  .tnode.shown.dim { opacity: 0.45; }
  .tnode.shown.dim:hover, .tnode.shown.dim:focus-visible { opacity: 1; }
  .tnode:hover, .tnode:focus-visible, .tnode[aria-expanded='true'] { color: var(--color-ink); }
  .tnode:focus-visible { outline: none; }
  .tnode:focus-visible .hit { outline: 2px solid var(--color-ink); outline-offset: 3px; }
</style>

<script>
  type TreeNode = { name: string; kind: 'folder' | 'file'; href?: string; children?: TreeNode[] };
  type P = { x: number; y: number };
  type Pt = P & { tx: number; ty: number };
  type Box = { x0: number; x1: number; y0: number; y1: number };
  type Kind = 'trunk' | 'folder' | 'file';
  // A watercolour wash: many slightly different translucent copies of one shape,
  // in local coordinates around (0, 0). Where they overlap the paint gets denser,
  // so edges bleed softly and the middle pools, the way real washes do.
  type Wash = { paths: Path2D[]; color: string; alpha: number; op?: GlobalCompositeOperation };
  type Twig = { s: number; pts: P[]; bud: number; budColor: string; rot: number };
  // A painted canopy: a few overlapping, slightly uneven squares filled light-to-deep,
  // darker blotches where pigment pooled, and a thin wet edge.
  type Canopy = { layers: Path2D[]; blotches: Path2D[]; edge: Path2D; bleed: Path2D; light: string; deep: string; size: number };
  // One limb per item, like a family tree: each folder is a fork, and everything in it
  // gets its own limb fanning out from that fork.
  type Limb = {
    node: TreeNode;
    kind: Kind;
    depth: number;
    key: string;
    parent: Limb | null;
    angle: number;
    len: number;
    samples: { x: number; y: number; s: number }[];
    edges: { l: P[]; r: P[] }[]; // a few slightly different outlines of the stem, painted on top of each other
    tip: Pt;
    twigs: Twig[];
    crown: Canopy | null; // folders: a big canopy; pages: a small one. Centred on the tip.
    crownSize: number;
    el: HTMLElement | null;
    box: Box | null;
    kids: Limb[];
    grow: Tween;
    focus: Tween;
    hover: Tween; // the canopy swells a little under the pointer
    dying: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-tree]')!;
  const [bgCanvas, canvas, grainCanvas] = [...root.querySelectorAll('canvas')];
  const ctx = canvas.getContext('2d')!;
  const world = root.querySelector<HTMLElement>('[data-world]')!;
  const pathEl = document.querySelector<HTMLElement>('[data-path]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const data: TreeNode = JSON.parse(document.getElementById('tree-data')!.textContent!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  const UP = -Math.PI / 2;
  let W = 0, H = 0, S = 1, narrow = false, DPR = 1;

  /* ---------- small helpers ---------- */
  const easeOut = (u: number) => 1 - Math.pow(1 - u, 3);
  const easeIn = (u: number) => u * u * u;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  class Tween {
    v: number; from: number; to: number; t0 = 0; dur = 0; ease = easeOut;
    constructor(v: number) { this.v = this.from = this.to = v; }
    go(to: number, seconds: number, ease = easeOut, delay = 0) {
      this.from = this.v; this.to = to; this.t0 = performance.now() + (reduced ? 0 : delay * 1000);
      this.dur = reduced ? 0 : seconds * 1000; this.ease = ease;
      wake();
    }
    set(v: number) { this.v = this.from = this.to = v; }
    tick(now: number) {
      if (this.v === this.to) return false;
      if (now < this.t0) return true; // waiting out a delay
      const u = this.dur ? Math.min(1, (now - this.t0) / this.dur) : 1;
      this.v = u >= 1 ? this.to : this.from + (this.to - this.from) * this.ease(u);
      return true;
    }
  }

  function hash(str: string) {
    let h = 2166136261;
    for (let i = 0; i < str.length; i++) h = Math.imul(h ^ str.charCodeAt(i), 16777619);
    return h >>> 0;
  }
  function rngFrom(seed: number) {
    return () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const gauss = (rnd: () => number) => (rnd() + rnd() + rnd() - 1.5) / 1.5;

  const css = getComputedStyle(document.documentElement);
  const C = (name: string) => css.getPropertyValue(`--color-${name}`).trim();
  const PAPER = C('paper');
  const STEM = C('stem'), STEM_DEEP = C('stem-deep');
  const LEAVES = [C('leaf-sage'), C('leaf-teal'), C('leaf-deep')];
  const MINT = C('leaf-mint'), ROSE = C('wash-rose'), BUD = C('bud');

  /* ---------- watercolour washes ---------- */
  // Push every edge's midpoint out by a random amount, recursively: a shape's outline
  // gets the irregular, bleeding edge of paint on wet paper.
  function deform(pts: P[], variance: number, rnd: () => number): P[] {
    const out: P[] = [];
    for (let i = 0; i < pts.length; i++) {
      const a = pts[i], b = pts[(i + 1) % pts.length];
      const len = Math.hypot(b.x - a.x, b.y - a.y);
      const ang = rnd() * Math.PI * 2, d = gauss(rnd) * len * variance;
      out.push(a, { x: (a.x + b.x) / 2 + Math.cos(ang) * d, y: (a.y + b.y) / 2 + Math.sin(ang) * d });
    }
    return out;
  }
  // A rounded square (n≈4) or a soft round shape (n≈2), radius r.
  function blobShape(r: number, n: number, rx = 1, ry = 1, count = 22): P[] {
    return Array.from({ length: count }, (_, i) => {
      const a = (i / count) * Math.PI * 2, c = Math.cos(a), s = Math.sin(a);
      return { x: r * rx * Math.sign(c) * Math.pow(Math.abs(c), 2 / n), y: r * ry * Math.sign(s) * Math.pow(Math.abs(s), 2 / n) };
    });
  }
  function toPath(pts: P[]) {
    const p = new Path2D();
    pts.forEach((q, i) => (i ? p.lineTo(q.x, q.y) : p.moveTo(q.x, q.y)));
    p.closePath();
    return p;
  }
  function wash(shape: P[], color: string, rnd: () => number, layers = 14, alpha = 0.07, v = 0.12): Wash {
    const base = deform(deform(shape, v * 1.6, rnd), v, rnd);
    const paths = Array.from({ length: layers }, () => toPath(deform(deform(base, v, rnd), v * 0.8, rnd)));
    return { paths, color, alpha };
  }
  function drawWash(w: Wash, x: number, y: number, scale: number, alpha: number) {
    if (alpha <= 0.002 || scale <= 0.01) return;
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(scale, scale);
    ctx.globalAlpha = w.alpha * alpha;
    ctx.fillStyle = w.color;
    if (w.op) ctx.globalCompositeOperation = w.op;
    for (const p of w.paths) ctx.fill(p);
    ctx.restore();
  }

  /* ---------- sizes ---------- */
  const k = () => lerp(0.72, 1, (S - 0.62) / 0.38);
  // How much a level's spread shrinks as the tree climbs: wide at the bottom, gathering
  // toward the top like a crown.
  const taper = (depth: number) => [1, 1, 0.8, 0.66, 0.56][Math.min(depth, 4)];

  // forkHalf: half the size of the canopy this limb grows out of (0 for the trunk's fork).
  // Limbs never get shorter than it takes to keep their canopy clear of that one.
  function sizeFor(kind: Kind, depth: number, center: boolean, forkHalf = 0): { len: number; w: [number, number] } {
    const kk = k();
    const W2 = (a: number, b: number): [number, number] => [a * kk, b * kk];
    // shorter screens get a slightly shorter trunk, so pot, fork and canopies all fit at once
    if (kind === 'trunk') return { len: clamp(H * (H < 820 ? 0.3 : 0.34), 170, 400), w: W2(36, 15) };
    if (kind === 'folder') {
      const want = clamp(H * 0.23, 140, 240) * (depth === 1 ? 1 : 0.84);
      const min = forkHalf + canopyFor(depth) / 2 + 22;
      return { len: Math.max(want, min), w: depth === 1 ? W2(20, 9) : W2(15, 7) };
    }
    const side = (narrow ? 128 : clamp(W * 0.2, 150, 290)) * taper(depth); // wide screens spread further
    // on phones the middle page sits higher than its neighbours, so their labels stack instead of colliding
    const want = center ? (narrow ? 158 : side * 0.68) : side;
    const min = (forkHalf || 18) + leafFor(center, depth) / 2 + 14;
    return { len: Math.max(want, min), w: depth === 1 ? W2(12, 4.5) : depth === 2 ? W2(10, 4) : W2(8.5, 3.5) };
  }
  const canopyFor = (depth: number) => (narrow ? (depth === 1 ? 128 : 112) : (depth === 1 ? 170 : 150)) * k();
  // pages' canopies: big enough to read as the thing you click; the ones out on the sides biggest
  const leafFor = (center: boolean, depth = 1) =>
    (narrow ? (center ? 70 : 82) * (depth >= 3 ? 0.86 : 1) : (center ? 104 : 124)) * k();

  function makeCanopy(size: number, light: string, deep: string, rnd: () => number): Canopy {
    const sq = blobShape(size / 2, 5.5, 1, 1, 28);
    // several uneven passes of paint, each a little smaller and shifted, so the edge shows soft bands
    const layers = Array.from({ length: 6 }, (_, i) => {
      const sh = { x: gauss(rnd) * 2.2, y: gauss(rnd) * 2.2 }, f = 1 - i * 0.045;
      return toPath(deform(deform(sq.map((q) => ({ x: q.x * f + sh.x, y: q.y * f + sh.y })), 0.06, rnd), 0.05, rnd));
    });
    // pigment pooling in a few places, mostly low in the canopy
    const blotches = Array.from({ length: 7 }, () => {
      const r = size * (0.07 + rnd() * 0.16), cx0 = (rnd() - 0.5) * size * 0.6, cy0 = (rnd() - 0.1) * size * 0.55;
      return toPath(deform(deform(blobShape(r, 2, 1, 0.8, 12).map((q) => ({ x: q.x + cx0, y: q.y + cy0 })), 0.22, rnd), 0.15, rnd));
    });
    const edge = toPath(deform(deform(sq, 0.05, rnd), 0.04, rnd)); // the darker line where a wash dries
    const bleed = toPath(deform(deform(sq.map((q) => ({ x: q.x * 1.07, y: q.y * 1.07 })), 0.1, rnd), 0.08, rnd)); // paint creeping into the paper
    return { layers, blotches, edge, bleed, light, deep, size };
  }

  function drawCanopy(c: Canopy, x: number, y: number, scale: number, alpha: number) {
    if (alpha <= 0.002 || scale <= 0.01) return;
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(scale, scale);
    const h = c.size / 2;
    const g = ctx.createLinearGradient(0, -h, 0, h);
    g.addColorStop(0, c.light);
    g.addColorStop(1, c.deep);
    ctx.fillStyle = c.light;
    ctx.globalAlpha = 0.09 * alpha;
    ctx.fill(c.bleed);
    ctx.fillStyle = g;
    ctx.globalAlpha = 0.2 * alpha;
    for (const p of c.layers) ctx.fill(p);
    ctx.fillStyle = c.deep;
    ctx.globalAlpha = 0.13 * alpha;
    for (const p of c.blotches) ctx.fill(p);
    ctx.strokeStyle = c.deep;
    ctx.lineWidth = 1.6 / scale;
    ctx.globalAlpha = 0.2 * alpha;
    ctx.stroke(c.edge);
    ctx.restore();
  }

  /* ---------- geometry ---------- */
  function makeLimb(node: TreeNode, kind: Kind, depth: number, key: string, parent: Limb | null,
                    anchor: P, angle: number, center: boolean, stretch = 1): Limb {
    const rnd = rngFrom(hash(key));
    const size = sizeFor(kind, depth, center, parent ? parent.crownSize / 2 : 0);
    const len = size.len * stretch, w = size.w;
    const dir = (a: number) => ({ x: Math.cos(a), y: Math.sin(a) });
    // Limbs that lean out to the side leave flatter and curl upward; limbs up the middle
    // get a gentle S.
    const side = Math.abs(Math.cos(angle)) > 0.25;
    const b1 = side ? Math.sign(Math.cos(angle)) * 0.36 : (rnd() - 0.5) * 0.3;
    const b2 = side ? -b1 : b1;
    const P0 = anchor;
    const P3 = { x: P0.x + len * Math.cos(angle), y: P0.y + len * Math.sin(angle) };
    const d1 = dir(angle + b1), d2 = dir(angle + b2);
    const P1 = { x: P0.x + len * 0.38 * d1.x, y: P0.y + len * 0.38 * d1.y };
    const P2 = { x: P3.x - len * 0.38 * d2.x, y: P3.y - len * 0.38 * d2.y };

    const N = 160;
    const samples: { x: number; y: number; s: number }[] = [];
    let s = 0;
    const amp = clamp(len * 0.02, 1.5, 8), freq = 1.2 + rnd(), phase = rnd() * Math.PI * 2;
    const base = Array.from({ length: N + 1 }, (_, i) => {
      const t = i / N, m = 1 - t;
      return {
        x: m * m * m * P0.x + 3 * m * m * t * P1.x + 3 * m * t * t * P2.x + t * t * t * P3.x,
        y: m * m * m * P0.y + 3 * m * m * t * P1.y + 3 * m * t * t * P2.y + t * t * t * P3.y,
      };
    });
    base.forEach((p, i) => {
      const a = base[Math.max(0, i - 1)], c = base[Math.min(N, i + 1)];
      const dl = Math.hypot(c.x - a.x, c.y - a.y) || 1, t = i / N;
      const off = Math.sin(t * Math.PI * freq + phase) * amp * Math.sin(Math.PI * t);
      const x = p.x - ((c.y - a.y) / dl) * off, y = p.y + ((c.x - a.x) / dl) * off;
      if (samples.length) { const q = samples[samples.length - 1]; s += Math.hypot(x - q.x, y - q.y); }
      samples.push({ x, y, s });
    });

    const limb: Limb = {
      node, kind, depth, key, parent, angle, len: s, samples, edges: [], tip: { x: 0, y: 0, tx: 0, ty: -1 },
      twigs: [], crown: null, crownSize: 0, el: null, box: null, kids: [],
      grow: new Tween(0), focus: new Tween(1), hover: new Tween(0), dying: false,
    };
    limb.tip = at(limb, limb.len);

    // The stem: three outlines of slightly different widths, each with its own gentle wobble.
    // Painted over each other at low opacity they give a soft edge and a denser core.
    const kk = k();
    for (const wf of [1.12, 1, 0.78]) {
      const ph = rnd() * 10, l: P[] = [], r: P[] = [];
      samples.forEach((q, i) => {
        const t = q.s / limb.len;
        const p = at(limb, q.s);
        const flare = kind === 'trunk' ? 26 * kk * Math.pow(Math.max(0, 1 - t / 0.12), 2) : 0;
        const ww = (lerp(w[0], w[1], Math.pow(t, 0.8)) + flare) * wf * (1 + 0.08 * Math.sin(i * 0.21 + ph));
        const nx = -p.ty, ny = p.tx;
        l.push({ x: q.x + nx * ww / 2, y: q.y + ny * ww / 2 });
        r.push({ x: q.x - nx * ww / 2, y: q.y - ny * ww / 2 });
      });
      limb.edges.push({ l, r });
    }

    // Candelabra twigs: a short stem out to the side that turns up and ends in a square bud.
    const twigCount = kind === 'trunk' ? 2 : kind === 'folder' ? 2 : 1 + Math.floor(rnd() * 2);
    for (let i = 0; i < twigCount; i++) {
      const st = (0.3 + rnd() * 0.5) * limb.len;
      const p = at(limb, st);
      const sideSign = rnd() < 0.5 ? -1 : 1;
      const out = (10 + rnd() * 14) * kk, up = (18 + rnd() * 24) * kk;
      const nx = -p.ty * sideSign, ny = p.tx * sideSign;
      const a = { x: p.x, y: p.y }, b = { x: p.x + nx * out, y: p.y + ny * out };
      const pts: P[] = [];
      for (let j = 0; j <= 8; j++) { // the elbow, out then up
        const t = j / 8, e = t * t;
        pts.push({ x: lerp(a.x, b.x, Math.sqrt(t)), y: lerp(a.y, b.y, t) - up * e });
      }
      limb.twigs.push({ s: st, pts, bud: (7 + rnd() * 4) * kk, budColor: rnd() < 0.5 ? BUD : LEAVES[2], rot: (rnd() - 0.5) * 0.3 });
    }

    // Folders bloom into a big canopy; pages end in a small one.
    if (kind !== 'trunk') {
      const size = kind === 'folder' ? canopyFor(depth) : leafFor(center, depth);
      const pick = hash(key) % 3;
      const [light, deep] = kind === 'folder'
        ? (pick === 0 ? [MINT, LEAVES[1]] : pick === 1 ? [LEAVES[0], LEAVES[2]] : [MINT, LEAVES[2]])
        : (pick === 0 ? [LEAVES[0], LEAVES[1]] : pick === 1 ? [MINT, LEAVES[1]] : [LEAVES[0], LEAVES[2]]);
      limb.crown = makeCanopy(size, light, deep, rnd);
      limb.crownSize = size;
    }
    return limb;
  }

  function at(b: { samples: { x: number; y: number; s: number }[] }, s: number): Pt {
    const sm = b.samples;
    let lo = 0, hi = sm.length - 1;
    while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (sm[mid].s < s) lo = mid; else hi = mid; }
    const a = sm[lo], c = sm[hi];
    const u = c.s === a.s ? 0 : clamp((s - a.s) / (c.s - a.s), 0, 1);
    const dx = c.x - a.x, dy = c.y - a.y, dl = Math.hypot(dx, dy) || 1;
    return { x: lerp(a.x, c.x, u), y: lerp(a.y, c.y, u), tx: dx / dl, ty: dy / dl };
  }

  /* ---------- the family-tree fan ---------- */
  const limbs: Limb[] = []; // everything drawn, including limbs pulling back in
  const open: Limb[] = []; // open folders: trunk first, deepest last
  const placed: Box[] = []; // labels and canopies, so labels avoid them
  const cam = { x: new Tween(0), y: new Tween(0) };
  let planted = false;

  // Angles (from straight up) for n children. Folders take the middle and keep climbing;
  // pages spread out to the sides on the same level.
  function fanFor(kids: TreeNode[], depth: number): number[] {
    const n = kids.length;
    // radians from straight up; higher levels fan narrower so the crown draws in
    const spread = narrow
      ? 1.0 * [1, 1, 0.86, 0.68, 0.62][Math.min(depth + 1, 4)]
      : 1.2 * [1, 1, 0.86, 0.76, 0.7][Math.min(depth + 1, 4)];
    let slots: number[];
    if (n === 1) slots = [0];
    else if (n === 2 && kids.some((c) => c.kind === 'folder')) slots = [0, (depth % 2 ? -1 : 1) * spread];
    else slots = Array.from({ length: n }, (_, i) => lerp(-spread, spread, i / (n - 1)));
    const order = kids.map((_, i) => i).sort((a, b) =>
      (kids[a].kind === 'folder' ? 0 : 1) - (kids[b].kind === 'folder' ? 0 : 1) || a - b);
    const bySlot = [...slots].sort((a, b) => Math.abs(a) - Math.abs(b) || a - b);
    const out: number[] = [];
    order.forEach((kidIndex, i) => (out[kidIndex] = bySlot[i]));
    return out;
  }

  function spawnKids(f: Limb, instant: boolean, delay = 0) {
    const kids = f.node.children ?? [];
    const slots = fanFor(kids, f.depth);
    const tipAngle = Math.atan2(f.tip.ty, f.tip.tx);
    const base = lerp(UP, tipAngle, 0.3);
    // Branches curl, so a canopy can land closer to the fork than its branch length suggests.
    // Grow each branch a little longer until its canopy is clear of the fork's and its siblings'.
    const boxOf = (l: Limb, pad = 0): Box => {
      const h = l.crownSize / 2 + pad;
      return { x0: l.tip.x - h, x1: l.tip.x + h, y0: l.tip.y - h, y1: l.tip.y + h };
    };
    const hits = (a: Box, b: Box) => a.x0 < b.x1 && a.x1 > b.x0 && a.y0 < b.y1 && a.y1 > b.y0;
    const taken: Box[] = f.crownSize ? [boxOf(f, 8)] : [];
    const order = kids.map((_, i) => i).sort((a, b) => Math.abs(slots[a]) - Math.abs(slots[b]));
    const made: Limb[] = [];
    for (const i of order) {
      const node = kids[i];
      let l: Limb, stretch = 1;
      do {
        l = makeLimb(node, node.kind === 'folder' ? 'folder' : 'file', f.depth + 1, `${f.key}/${node.name}`, f,
          { x: f.tip.x, y: f.tip.y }, base + slots[i], Math.abs(slots[i]) < 0.2, stretch);
        stretch += 0.06;
      } while (taken.some((t) => hits(boxOf(l, 4), t)) && stretch < 1.8);
      taken.push(boxOf(l, 4));
      made[i] = l;
    }
    f.kids = made;
    limbs.push(...made);
    // canopies first, so labels can steer around them
    for (const l of made) {
      const h = l.crownSize / 2;
      if (h) placed.push({ x0: l.tip.x - h, x1: l.tip.x + h, y0: l.tip.y - h, y1: l.tip.y + h });
    }
    made
      .map((l, i) => ({ l, slot: slots[i] }))
      .sort((a, b) => a.slot - b.slot) // left to right, which is also the Tab order
      .forEach(({ l, slot }) => {
        makeLabel(l);
        // the middle limb leads; the side limbs follow a beat later
        if (instant) l.grow.set(1);
        else l.grow.go(1, growTime(l), easeOut, delay + 0.07 * Math.round(Math.abs(slot) * 2));
      });
  }

  function growTime(b: Limb) { return 0.5 + b.len / 1600; }

  // Does a label box sit on any stem, or on another label or canopy?
  function blocked(r: Box, self: Limb) {
    const selfCrown = placed.find((q) => q.x0 === self.tip.x - self.crownSize / 2 && q.y0 === self.tip.y - self.crownSize / 2);
    for (const q of placed) {
      if (q === selfCrown) continue;
      if (r.x0 < q.x1 && r.x1 > q.x0 && r.y0 < q.y1 && r.y1 > q.y0) return true;
    }
    for (const l of limbs) {
      if (l.dying) continue;
      const sm = l.samples;
      for (let i = 0; i < sm.length; i += 2) {
        const p = sm[i];
        if (p.x > r.x0 - 4 && p.x < r.x1 + 4 && p.y > r.y0 - 5 && p.y < r.y1 + 5) return true;
      }
    }
    return false;
  }

  function makeLabel(l: Limb) {
    const isFolder = l.kind === 'folder';
    const el = document.createElement(isFolder ? 'button' : 'a');
    el.className = 'tnode';
    const text = `${l.node.name}${isFolder ? '/' : ''}`;
    const lw = text.length * 6.7 + 6;
    const { x, y } = l.tip;
    // offsets of the label's anchor from the tip, and how it reads from there
    const h = l.crownSize / 2 + 2;
    type Spot = { cls: string; dx: number; dy: number; box: Box };
    const spot = (cls: string, dx: number, dy: number): Spot => {
      const x0 = cls === 'read-left' ? x + dx - lw : cls === 'read-centre' ? x + dx - lw / 2 : x + dx;
      return { cls, dx, dy, box: { x0, x1: x0 + lw, y0: y + dy - 8, y1: y + dy + 8 } };
    };
    const right = spot('', h + 6, isFolder ? h * 0.55 : 0);
    const left = spot('read-left', -h - 6, isFolder ? h * 0.55 : 0);
    const over = spot('read-centre', 0, -h - 10);
    const under = spot('read-centre', 0, h + 10);
    // above the canopy but leaning outward, away from the stems in the middle
    const overOut = Math.cos(l.angle) < 0 ? spot('read-left', h, -h - 10) : spot('', -h, -h - 10);
    // Folders: beside the lower corner of the canopy, clear of the stem below and the limbs above.
    // Pages read outward; on phones every page label sits above its canopy so none run off screen.
    const leansLeft = Math.cos(l.angle) < -0.2;
    const outward = leansLeft ? [left, right] : [right, left];
    const tries: Spot[] = isFolder
      ? [right, left, under]
      : narrow ? [over, overOut, ...outward, under] : [...outward, over, under];
    const pick = tries.find((t) => !blocked(t.box, l)) ?? tries[0];
    if (pick.cls) el.classList.add(pick.cls);
    l.box = pick.box;
    placed.push(pick.box);

    // the whole canopy is the button
    const hitSize = l.crownSize * 0.96;
    el.innerHTML = `<span class="hit" style="width:${hitSize}px;height:${hitSize}px"></span>` +
      `<span class="label" style="left:${Math.round(pick.dx)}px;top:${Math.round(pick.dy)}px">${text}</span>`;
    el.style.left = `${Math.round(x)}px`;
    el.style.top = `${Math.round(y)}px`;
    el.tabIndex = -1;
    if (isFolder) {
      el.setAttribute('type', 'button');
      el.setAttribute('aria-expanded', 'false');
      el.addEventListener('click', () => toggle(l));
    } else {
      (el as HTMLAnchorElement).href = l.node.href!;
    }
    const hover = (on: boolean) => l.hover.go(on ? 1 : 0, on ? 0.35 : 0.5);
    el.addEventListener('pointerenter', () => hover(true));
    el.addEventListener('pointerleave', () => hover(false));
    el.addEventListener('focus', () => hover(true));
    el.addEventListener('blur', () => hover(false));
    world.appendChild(el);
    l.el = el;
  }

  /* ---------- opening and closing ---------- */
  function openFolder(f: Limb, instant = false) {
    closeBelow(open.indexOf(f.parent!));
    open.push(f);
    f.el?.setAttribute('aria-expanded', 'true');
    spawnKids(f, instant);
    refocus(instant);
  }

  // Pull back every limb grown from folders deeper than `index` in the open path.
  function closeBelow(index: number) {
    while (open.length > index + 1) {
      const f = open.pop()!;
      f.el?.setAttribute('aria-expanded', 'false');
      for (const kid of f.kids) {
        kid.dying = true;
        kid.grow.go(0, 0.4, easeIn);
        for (let i = placed.length - 1; i >= 0; i--) {
          const q = placed[i];
          const isCrown = q.x0 === kid.tip.x - kid.crownSize / 2 && q.y0 === kid.tip.y - kid.crownSize / 2;
          if (q === kid.box || isCrown) placed.splice(i, 1);
        }
        if (kid.el) { kid.el.tabIndex = -1; kid.el.classList.remove('shown'); }
      }
      f.kids = [];
    }
  }

  function toggle(f: Limb) {
    const i = open.indexOf(f);
    if (i === -1) openFolder(f);
    else { closeBelow(i - 1); refocus(); }
  }

  // The newest level is in focus; levels below it fade back.
  function refocus(instant = false) {
    const deepest = open[open.length - 1];
    for (const l of limbs) {
      if (l.dying) continue;
      const active = l.parent === deepest || l === deepest || (deepest.kind === 'trunk' && l.kind === 'trunk');
      const target = active ? 1 : 0.5;
      instant ? l.focus.set(target) : l.focus.go(target, 0.5);
      l.el?.classList.toggle('dim', !active && l.el.getAttribute('aria-expanded') !== 'true');
    }
    frame(deepest, instant);
    updateChrome();
  }

  /* ---------- camera ---------- */
  const headerSpace = () => (W < 700 ? 72 : 88);
  function frame(f: Limb, instant = false) {
    let tx: number, ty: number;
    if (!planted) {
      tx = -W / 2; ty = -(H * 0.6); // just the pot, a little below centre
    } else {
      // fit the open folder's fork and everything growing from it
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      const fit = (b: Box) => {
        minX = Math.min(minX, b.x0); minY = Math.min(minY, b.y0); maxX = Math.max(maxX, b.x1); maxY = Math.max(maxY, b.y1);
      };
      const grp = f.kind === 'trunk' ? [f, ...f.kids] : [f, ...f.kids];
      for (const l of grp) {
        for (const p of l.samples) fit({ x0: p.x, y0: p.y, x1: p.x, y1: p.y });
        const h = l.crownSize / 2 + 6;
        if (h > 6) fit({ x0: l.tip.x - h, y0: l.tip.y - h, x1: l.tip.x + h, y1: l.tip.y + h });
        if (l.box) fit(l.box);
      }
      if (f.kind === 'trunk') fit({ x0: -70 * POT_SCALE, y0: 0, x1: 70 * POT_SCALE, y1: potBottom() + 10 });
      else { // only the top of the folder's own limb: the fork, not the whole stem below it
        minY = Math.min(minY, f.tip.y - f.crownSize / 2);
        const keepBelow = f.tip.y + f.crownSize / 2 + 30;
        maxY = Math.max(Math.min(maxY, Math.max(keepBelow, ...f.kids.map((l) => (l.box ? l.box.y1 : l.tip.y)))), keepBelow);
      }
      const pad = W < 700 ? 16 : 72, top = headerSpace(), bottom = 56;
      const vw = W - pad * 2, vh = H - top - bottom;
      tx = maxX - minX <= vw ? (minX + maxX) / 2 - W / 2 : minX - pad;
      ty = maxY - minY <= vh ? (minY + maxY) / 2 - (top + vh / 2) : minY - top;
    }
    if (instant) { cam.x.set(tx); cam.y.set(ty); }
    else { cam.x.go(tx, 0.65); cam.y.go(ty, 0.65); }
  }

  /* ---------- chrome: path and item count ---------- */
  function updateChrome() {
    pathEl.innerHTML = '';
    open.forEach((f, i) => {
      if (i) pathEl.insertAdjacentHTML('beforeend', '<span class="sep">/</span>');
      const last = i === open.length - 1;
      const seg = document.createElement(last ? 'span' : 'button');
      seg.textContent = f.node.name;
      if (!last) {
        seg.setAttribute('type', 'button');
        seg.addEventListener('click', () => { closeBelow(i); refocus(); });
      } else seg.setAttribute('aria-current', 'location');
      pathEl.appendChild(seg);
    });
    if (!planted) { countEl.textContent = coarse ? 'Tap the pot' : 'Click the pot'; return; }
    const n = open[open.length - 1].node.children?.length ?? 0;
    countEl.textContent = `${n} item${n === 1 ? '' : 's'}`;
    history.replaceState(null, '', `#/${open.slice(1).map((f) => f.node.name).join('/')}`);
  }

  /* ---------- render loop ---------- */
  let raf = 0;
  function wake() { if (!raf) raf = requestAnimationFrame(draw); }

  function draw(now: number) {
    raf = 0;
    let busy = cam.x.tick(now) | cam.y.tick(now) | potLift.tick(now) | sprout.tick(now) ? true : false;
    for (const l of limbs) busy = l.grow.tick(now) || l.focus.tick(now) || l.hover.tick(now) || busy;

    const cx = Math.round(cam.x.v), cy = Math.round(cam.y.v);
    world.style.transform = `translate(${-cx}px, ${-cy}px)`;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, W, H);

    for (let i = limbs.length - 1; i >= 0; i--) {
      const l = limbs[i];
      if (l.dying && l.grow.v <= 0) { l.el?.remove(); limbs.splice(i, 1); }
    }
    // stems first, then canopies and buds over them, so limbs read as passing behind the paint
    ctx.globalCompositeOperation = 'multiply';
    for (const l of limbs) paintStem(l, cx, cy);
    for (const l of limbs) paintCrown(l, cx, cy);
    ctx.globalCompositeOperation = 'source-over';
    paintPot(cx, cy);

    if (busy) wake();
  }

  const fadeOf = (l: Limb) => l.focus.v * (l.dying ? Math.min(1, l.grow.v * 1.5) : 1);

  function paintStem(l: Limb, cx: number, cy: number) {
    const reach = l.grow.v * l.len;
    if (reach <= 0.5) return;
    const sm = l.samples;
    let end = 0;
    while (end < sm.length - 1 && sm[end + 1].s <= reach) end++;
    const fade = fadeOf(l);
    const tipPt = at(l, reach);
    // each outline painted at low opacity; overlaps make the core denser
    l.edges.forEach((e, i) => {
      const p = new Path2D();
      p.moveTo(e.l[0].x - cx, e.l[0].y - cy);
      for (let j = 1; j <= end; j++) p.lineTo(e.l[j].x - cx, e.l[j].y - cy);
      p.lineTo(tipPt.x + tipPt.tx * 2 - cx, tipPt.y + tipPt.ty * 2 - cy); // a soft point at the growing tip
      for (let j = end; j >= 0; j--) p.lineTo(e.r[j].x - cx, e.r[j].y - cy);
      p.closePath();
      ctx.globalAlpha = (i === 2 ? 0.38 : 0.3) * fade;
      ctx.fillStyle = i === 2 ? STEM_DEEP : STEM;
      ctx.fill(p);
    });
    // twigs grow out once the stem has passed them
    for (const t of l.twigs) {
      const g = clamp((reach - t.s) / 40, 0, 1);
      if (g <= 0) continue;
      const n = Math.max(2, Math.round(t.pts.length * g));
      ctx.globalAlpha = 0.7 * fade;
      ctx.strokeStyle = STEM;
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.beginPath();
      t.pts.slice(0, n).forEach((q, i) => (i ? ctx.lineTo(q.x - cx, q.y - cy) : ctx.moveTo(q.x - cx, q.y - cy)));
      ctx.stroke();
      if (g >= 1) {
        const e = t.pts[t.pts.length - 1];
        ctx.save();
        ctx.translate(e.x - cx, e.y - cy - t.bud / 2);
        ctx.rotate(t.rot);
        ctx.globalAlpha = 0.75 * fade;
        ctx.fillStyle = t.budColor;
        ctx.fillRect(-t.bud / 2, -t.bud / 2, t.bud, t.bud);
        ctx.restore();
      }
    }
  }

  // Canopies and buds bloom open as the limb arrives: they swell from about half size.
  function paintCrown(l: Limb, cx: number, cy: number) {
    // labels come in as the limb arrives
    if (l.el && !l.dying) {
      const shown = l.grow.v > 0.88;
      if (shown !== l.el.classList.contains('shown')) {
        l.el.classList.toggle('shown', shown);
        l.el.tabIndex = shown ? 0 : -1;
      }
    }
    if (!l.crown) return;
    const bloom = clamp((l.grow.v - 0.72) / 0.28, 0, 1);
    if (bloom <= 0) return;
    const hv = l.hover.v;
    drawCanopy(l.crown, l.tip.x - cx, l.tip.y - cy, lerp(0.5, 1, easeOut(bloom)) * (1 + 0.06 * hv),
      Math.min(1, fadeOf(l) * bloom * (1 + 0.35 * hv)));
  }

  /* ---------- the pot ---------- */
  // A painted terracotta pot, origin at the middle of the soil. y grows downward.
  let POT_SCALE = 1; // the pot grows with the tree on big screens
  const potBottom = () => 92 * POT_SCALE;
  const potLift = new Tween(0);
  const sprout = new Tween(0); // 0 resting, 1 perked up on hover
  let potWashes: { w: Wash; x: number; y: number }[] = [];
  let sproutLeaves: { w: Wash; x: number; y: number; rot: number; grow: number }[] = [];
  function buildPot() {
    const rnd = rngFrom(hash('pot'));
    const terra = C('pot'), light = C('pot-light'), shade = C('pot-shade'), line = C('pot-line'), soil = C('soil');
    const trap = (x0: number, x1: number, x2: number, x3: number, y0: number, y1: number): P[] => {
      const pts: P[] = [];
      const edge = (a: P, b: P) => { for (let i = 0; i < 6; i++) pts.push({ x: lerp(a.x, b.x, i / 6), y: lerp(a.y, b.y, i / 6) }); };
      edge({ x: x0, y: y0 }, { x: x1, y: y0 }); edge({ x: x1, y: y0 }, { x: x2, y: y1 });
      edge({ x: x2, y: y1 }, { x: x3, y: y1 }); edge({ x: x3, y: y1 }, { x: x0, y: y0 });
      return pts;
    };
    potWashes = [
      { w: wash(blobShape(78, 2, 1, 0.13), ROSE, rnd, 10, 0.06, 0.1), x: 0, y: 94 }, // shadow on the paper
      { w: wash(trap(-44, 44, 32, -32, 18, 92), terra, rnd, 14, 0.09, 0.05), x: 0, y: 0 }, // body
      { w: wash(trap(10, 44, 32, 6, 20, 92), shade, rnd, 10, 0.07, 0.04), x: 0, y: 0 }, // shaded side
      { w: wash(trap(-40, -24, -22, -30, 22, 88), light, rnd, 8, 0.07, 0.05), x: 0, y: 0 }, // light side
      { w: wash(trap(-52, 52, 50, -50, 0, 20), terra, rnd, 14, 0.1, 0.035), x: 0, y: 0 }, // rim
      { w: wash(trap(16, 52, 50, 14, 2, 20), shade, rnd, 8, 0.07, 0.03), x: 0, y: 0 },
      { w: wash(blobShape(46, 2, 1, 0.12), soil, rnd, 10, 0.12, 0.05), x: 0, y: 2 }, // soil
      { w: wash(trap(-52, 52, 50, -50, 19, 22), line, rnd, 6, 0.08, 0.02), x: 0, y: 0 }, // shadow under the rim
    ];
    sproutLeaves = [
      { w: wash(blobShape(9, 2, 1, 0.45), LEAVES[0], rnd, 8, 0.16, 0.08), x: -9, y: -20, rot: -0.5, grow: 0 },
      { w: wash(blobShape(10, 2, 1, 0.42), LEAVES[1], rnd, 8, 0.16, 0.08), x: 10, y: -27, rot: 0.45, grow: 0 },
      { w: wash(blobShape(8, 2, 1, 0.45), LEAVES[0], rnd, 8, 0.16, 0.08), x: -6, y: -38, rot: -0.7, grow: 1 },
    ];
  }

  function paintPot(cx: number, cy: number) {
    const lift = potLift.v;
    ctx.save();
    ctx.translate(-cx, -cy + lift);
    ctx.scale(POT_SCALE, POT_SCALE);
    cx = 0; cy = 0;
    ctx.globalCompositeOperation = 'multiply';
    for (const p of potWashes) drawWash(p.w, p.x, p.y, 1, 1);
    if (!planted) {
      // the sprout waiting in the soil; it stands up a little taller on hover
      const h = lerp(30, 42, sprout.v);
      ctx.globalAlpha = 0.7;
      ctx.strokeStyle = STEM;
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(0, 2);
      ctx.quadraticCurveTo(4, -h * 0.5, -1, -h);
      ctx.stroke();
      for (const leaf of sproutLeaves) {
        const show = leaf.grow ? sprout.v : 1;
        if (show <= 0.01) continue;
        const dy = leaf.y * lerp(1, 1.3, sprout.v);
        ctx.save();
        ctx.translate(leaf.x, dy);
        ctx.rotate(leaf.rot);
        drawWash(leaf.w, 0, 0, show, 1);
        ctx.restore();
      }
    }
    ctx.globalCompositeOperation = 'source-over';
    ctx.globalAlpha = 1;
    ctx.restore();
  }

  let potBtn: HTMLButtonElement;
  function makePotButton() {
    potBtn = document.createElement('button');
    potBtn.type = 'button';
    potBtn.className = 'pot-btn';
    const ps = POT_SCALE;
    Object.assign(potBtn.style, { left: `${-64 * ps}px`, top: `${-56 * ps}px`, width: `${128 * ps}px`, height: `${156 * ps}px` });
    const hover = (on: boolean) => sprout.go(on ? 1 : 0, 0.45);
    potBtn.addEventListener('pointerenter', () => hover(true));
    potBtn.addEventListener('pointerleave', () => hover(false));
    potBtn.addEventListener('focus', () => hover(true));
    potBtn.addEventListener('blur', () => hover(false));
    potBtn.addEventListener('click', () => {
      potLift.go(-4, 0.1);
      setTimeout(() => potLift.go(0, 0.35), 100);
      if (!planted) growTree();
      else if (open.length > 1) { closeBelow(0); refocus(); } // the pot also takes you back to the top
    });
    world.appendChild(potBtn);
    labelPot();
  }
  function labelPot() {
    potBtn.setAttribute('aria-label', planted ? 'Back to the top of the tree' : 'Grow the tree');
  }

  function growTree() {
    planted = true;
    labelPot();
    const trunk = open[0];
    const t = growTime(trunk);
    trunk.grow.go(1, t);
    spawnKids(trunk, false, t * 0.72); // the first fork opens as the trunk tops out
    refocus();
  }

  /* ---------- paper: background washes and grain ---------- */
  function paintPaper() {
    const b = bgCanvas.getContext('2d')!;
    bgCanvas.width = Math.round(W * DPR); bgCanvas.height = Math.round(H * DPR);
    b.setTransform(DPR, 0, 0, DPR, 0, 0);
    b.fillStyle = PAPER;
    b.fillRect(0, 0, W, H);
    // the paper was washed before the tree was painted: a warm rose glow up high,
    // a cool sage one down low, and a few faint upright washes far off, like distant trunks
    const rnd = rngFrom(hash('paper'));
    const glow = (x: number, y: number, r: number, col: string, a: number) => {
      const g = b.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, col); g.addColorStop(1, 'rgba(255,255,255,0)');
      b.globalAlpha = a; b.fillStyle = g; b.fillRect(0, 0, W, H);
    };
    glow(W * 0.82, H * 0.08, Math.max(W, H) * 0.7, ROSE, 0.42);
    glow(W * 0.1, H * 1.0, Math.max(W, H) * 0.6, MINT, 0.5);
    const streaks = Math.round(W / 220);
    for (let i = 0; i < streaks; i++) {
      const x = (i + 0.2 + rnd() * 0.6) * (W / streaks), w = 14 + rnd() * 46;
      const g = b.createLinearGradient(x - w / 2, 0, x + w / 2, 0);
      g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(0.5, ROSE); g.addColorStop(1, 'rgba(255,255,255,0)');
      b.globalAlpha = 0.1 + rnd() * 0.1;
      b.fillStyle = g;
      b.fillRect(x - w / 2, 0, w, H * (0.55 + rnd() * 0.45));
    }
    b.globalAlpha = 1;
    // grain: soft speckle, multiplied over everything painted
    const g = grainCanvas.getContext('2d')!;
    grainCanvas.width = Math.round(W * DPR); grainCanvas.height = Math.round(H * DPR);
    const tile = document.createElement('canvas');
    tile.width = tile.height = 160;
    const t = tile.getContext('2d')!;
    const img = t.createImageData(160, 160);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = 255 - Math.floor(Math.pow(rnd(), 3) * 46);
      img.data[i] = v; img.data[i + 1] = v - 2; img.data[i + 2] = v - 6; img.data[i + 3] = 255;
    }
    t.putImageData(img, 0, 0);
    g.fillStyle = g.createPattern(tile, 'repeat')!;
    g.fillRect(0, 0, grainCanvas.width, grainCanvas.height);
  }

  /* ---------- setup ---------- */
  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight; S = clamp(W / 1200, 0.62, 1);
    narrow = W < 700;
    POT_SCALE = narrow ? 1 : H < 820 ? 1.1 : 1.3;
    canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
    paintPaper();
  }

  function plant(path: string[]) {
    world.innerHTML = '';
    limbs.length = 0; open.length = 0; placed.length = 0;
    const trunk = makeLimb(data, 'trunk', 0, 'evan', null, { x: 0, y: 6 * POT_SCALE }, UP, true);
    limbs.push(trunk);
    open.push(trunk);
    makePotButton();
    if (planted) {
      trunk.grow.set(1);
      spawnKids(trunk, true);
      let f = trunk;
      for (const name of path) {
        const next = f.kids.find((l) => l.kind === 'folder' && l.node.name === name);
        if (!next) break;
        openFolder(next, true);
        f = next;
      }
    }
    refocus(true);
  }

  // "#/…" in the address means the tree is already grown (e.g. coming back from a page).
  const readHash = () => ({
    grown: location.hash.startsWith('#/'),
    path: decodeURIComponent(location.hash.replace(/^#\/?/, '')).split('/').filter(Boolean),
  });

  document.documentElement.classList.add('js');
  resize();
  buildPot();
  const start = readHash();
  planted = start.grown;
  plant(start.path);
  wake();

  let resizeTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      const path = open.slice(1).map((f) => f.node.name);
      resize(); plant(path); wake();
    }, 150);
  });

  // A link to another folder on this page (e.g. /#/work) replants the tree there.
  addEventListener('hashchange', () => {
    const next = readHash();
    if (!next.grown) return;
    planted = true; plant(next.path); wake();
  });

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open.length > 1) { closeBelow(open.length - 2); refocus(); }
  });
</script>
