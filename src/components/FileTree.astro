---
/*
  The home page: the site as a literal file tree, after Finn Taylor's
  "Literal file tree", shaped like a family tree. It starts as a planted
  terracotta pot; clicking the pot grows a sapling that forks. Every item in a
  folder gets its own limb fanning out from that fork: folders climb up the
  middle, pages spread to the sides on the same level. The tree is full-grown
  from the start; it grows outward as people open folders.

  Motion measured from the reference video (DESIGN-BRIEF.md, "The tree"):
  - a branch grows in ~0.85s, fast then slowing; moss fills in just behind the tip
  - opening a folder pans the view ~0.65s to follow the new branch, at the same time
  - older branches thin out as you go deeper; closing pulls a branch back in ~0.4s
*/
import { tree } from '../data/tree';
// The nested list below holds every page, shown if JavaScript is off.
---

<div class="tree-root" data-tree>
  <canvas class="tree-canvas" aria-hidden="true"></canvas>
  <div class="tree-world" data-world></div>

  <nav class="tree-list" aria-label="Pages">
    <ul>
      {tree.children!.map((a) => (
        <li>
          {a.kind === 'file' ? <a href={a.href}>{a.name}</a> : <span>{a.name}/</span>}
          {a.children && (
            <ul>
              {a.children.map((b) => (
                <li>
                  {b.kind === 'file' ? <a href={b.href}>{b.name}</a> : <span>{b.name}/</span>}
                  {b.children && (
                    <ul>
                      {b.children.map((c) => (
                        <li><a href={c.href}>{c.name}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</div>

<script type="application/json" id="tree-data" set:html={JSON.stringify(tree)} />

<style is:global>
  .tree-root { position: fixed; inset: 0; overflow: hidden; }
  .tree-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .tree-world { position: absolute; left: 0; top: 0; will-change: transform; }

  /* Every page as a plain list, for when JavaScript is off. With it on, the tree's own
     links and folder buttons (with aria-expanded) do the job, so the list steps aside. */
  .tree-list { padding: 96px 24px; font-size: var(--text-base); line-height: 2; }
  html.js .tree-list { display: none; }
  html:not(.js) .tree-list ul ul { padding-left: 1.25rem; }

  .pot-btn { position: absolute; padding: 0; background: none; border: 0; border-radius: 14px; cursor: pointer; }

  .tnode {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 8px;
    margin: -6px -8px;
    font: inherit;
    font-size: 12.5px;
    line-height: 1;
    color: var(--color-quiet);
    background: none;
    border: 0;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.25s ease, transform 0.35s var(--ease-weight), color 0.15s ease;
    pointer-events: none;
  }
  .tnode.shown { opacity: 1; transform: none; pointer-events: auto; }
  .tnode.shown.dim { opacity: 0.4; }
  .tnode.shown.dim:hover, .tnode.shown.dim:focus-visible { opacity: 1; }
  .tnode:hover, .tnode:focus-visible, .tnode[aria-expanded='true'] { color: var(--color-ink); }
  .tnode svg { flex: none; width: 16px; height: 16px; fill: var(--color-page); stroke: currentColor; stroke-width: 1.15; stroke-linejoin: round; }
  .tnode .label { text-shadow: 0 0 3px var(--color-page), 0 0 3px var(--color-page), 0 0 6px var(--color-page); }
  /* folder labels sit just off the branch; files on the left of a steep branch read leftward */
  .tnode.label-below .label, .tnode.label-above .label { position: absolute; left: 27px; }
  .tnode.label-below .label { top: 19px; }
  .tnode.label-above .label { top: -7px; }
  .tnode.flip { flex-direction: row-reverse; translate: -100% 0; }
  .tnode.label-over .label { position: absolute; left: 16px; top: -15px; translate: -50% 0; }
  .tnode .open-icon { display: none; }
  .tnode[aria-expanded='true'] .open-icon { display: block; }
  .tnode[aria-expanded='true'] .closed-icon { display: none; }
</style>

<script>
  type TreeNode = { name: string; kind: 'folder' | 'file'; href?: string; children?: TreeNode[] };
  type Pt = { x: number; y: number; tx: number; ty: number };
  type Box = { x0: number; x1: number; y0: number; y1: number };
  // need: how mature the tree must be (0..1) before this pixel shows
  type Pix = { gx: number; gy: number; s: number; thr: number; moss: boolean; need: number };
  type Kind = 'trunk' | 'folder' | 'file';
  // One limb per item, like a family tree: each folder is a fork, and everything in it
  // gets its own limb fanning out from that fork.
  type Limb = {
    node: TreeNode;
    kind: Kind;
    depth: number;
    key: string;
    parent: Limb | null;
    angle: number;
    len: number;
    w: [number, number];
    samples: { x: number; y: number; s: number }[];
    tip: Pt;
    buckets: Map<string, Pix[]>;
    el: HTMLElement | null;
    box: Box | null;
    kids: Limb[];
    grow: Tween;
    moss: Tween;
    dying: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-tree]')!;
  const canvas = root.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const world = root.querySelector<HTMLElement>('[data-world]')!;
  const pathEl = document.querySelector<HTMLElement>('[data-path]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const data: TreeNode = JSON.parse(document.getElementById('tree-data')!.textContent!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  const G = 3; // size of one tree pixel, in CSS px
  const UP = -Math.PI / 2;
  let W = 0, H = 0, S = 1, narrow = false;

  /* ---------- small helpers ---------- */
  const easeOut = (u: number) => 1 - Math.pow(1 - u, 3);
  const easeIn = (u: number) => u * u * u;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  class Tween {
    v: number; from: number; to: number; t0 = 0; dur = 0; ease = easeOut;
    constructor(v: number) { this.v = this.from = this.to = v; }
    go(to: number, seconds: number, ease = easeOut, delay = 0) {
      this.from = this.v; this.to = to; this.t0 = performance.now() + (reduced ? 0 : delay * 1000);
      this.dur = reduced ? 0 : seconds * 1000; this.ease = ease;
      wake();
    }
    set(v: number) { this.v = this.from = this.to = v; }
    tick(now: number) {
      if (this.v === this.to) return false;
      if (now < this.t0) return true; // waiting out a delay
      const u = this.dur ? Math.min(1, (now - this.t0) / this.dur) : 1;
      this.v = u >= 1 ? this.to : this.from + (this.to - this.from) * this.ease(u);
      return true;
    }
  }

  function hash(str: string) {
    let h = 2166136261;
    for (let i = 0; i < str.length; i++) h = Math.imul(h ^ str.charCodeAt(i), 16777619);
    return h >>> 0;
  }
  function rngFrom(seed: number) {
    return () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const css = getComputedStyle(document.documentElement);
  const C = (name: string) => css.getPropertyValue(`--color-${name}`).trim();
  const BARK = { light: C('bark-light'), mid: C('bark'), dark: C('bark-dark'), speck: C('bark-speck') };
  const MOSS = [
    [C('moss-lime'), 0.34],
    [C('moss-bright'), 0.22],
    [C('moss-olive'), 0.18],
    [C('moss-pale'), 0.14],
    [C('moss-cream'), 0.12],
  ] as const;
  const pickMoss = (r: number) => {
    let acc = 0;
    for (const [c, w] of MOSS) { acc += w; if (r < acc) return c; }
    return MOSS[0][0];
  };
  const YOUNG = [C('moss-bright'), C('moss-lime'), C('moss-pale')];
  const pickYoung = (r: number) => YOUNG[Math.floor(r * YOUNG.length)];
  const leafFor = (need: number, r: number, r2: number) => (need < 0.35 ? pickYoung(r) : pickMoss(r2));

  /* ---------- icons ---------- */
  const ICON = {
    closed: '<svg class="closed-icon" viewBox="0 0 16 16"><path d="M1.6 3.6a1 1 0 0 1 1-1h3.5l1.4 1.5h5.9a1 1 0 0 1 1 1v6.8a1 1 0 0 1-1 1H2.6a1 1 0 0 1-1-1z"/></svg>',
    open: '<svg class="open-icon" viewBox="0 0 16 16"><path d="M1.6 12.4V3.6a1 1 0 0 1 1-1h3.5l1.4 1.5h4.9a1 1 0 0 1 1 1v1.4"/><path d="M1.6 12.4l2.1-5.3h11l-2.1 5.3z"/></svg>',
    file: '<svg viewBox="0 0 16 16"><path d="M3.6 1.6h5.9l2.9 2.9v9.9H3.6z"/><path d="M9.5 1.6v2.9h2.9M5.8 8h4.4M5.8 10.4h4.4"/></svg>',
  };

  /* ---------- sizes ---------- */
  const k = () => lerp(0.72, 1, (S - 0.62) / 0.38);
  const ageLen = () => 1;
  function sizeFor(kind: Kind, depth: number, center: boolean): { len: number; w: [number, number] } {
    const kk = k();
    if (kind === 'trunk')
      return { len: clamp(H * 0.34, 150, 330), w: [22 * kk, 9 * kk] };
    if (kind === 'folder')
      return { len: clamp(H * 0.19, 120, 185) * ageLen(), w: (depth === 1 ? [12, 5] : [9, 3.6]).map((v) => v * kk) as [number, number] };
    // pages on the sides reach far out, so each level spreads wide like a family tree
    const base = narrow ? (center ? 96 : 118) : (center ? 140 : 215);
    return {
      len: base * ageLen(),
      w: (depth === 1 ? [8, 2.6] : depth === 2 ? [6.5, 2.2] : [5.5, 2]).map((v) => v * kk) as [number, number],
    };
  }

  /* ---------- geometry ---------- */
  function makeLimb(node: TreeNode, kind: Kind, depth: number, key: string, parent: Limb | null,
                    anchor: { x: number; y: number }, angle: number, center: boolean): Limb {
    const rnd = rngFrom(hash(key));
    const { len, w } = sizeFor(kind, depth, center);
    const dir = (a: number) => ({ x: Math.cos(a), y: Math.sin(a) });
    // Limbs that lean out to the side leave flatter and curl upward, like real branches.
    // Limbs that grow up the middle get a gentle S.
    const side = Math.abs(Math.cos(angle)) > 0.25;
    const b1 = side ? Math.sign(Math.cos(angle)) * 0.34 : (rnd() - 0.5) * 0.3;
    const b2 = side ? -b1 : b1;
    const P0 = anchor;
    const P3 = { x: P0.x + len * Math.cos(angle), y: P0.y + len * Math.sin(angle) };
    const d1 = dir(angle + b1), d2 = dir(angle + b2);
    const P1 = { x: P0.x + len * 0.38 * d1.x, y: P0.y + len * 0.38 * d1.y };
    const P2 = { x: P3.x - len * 0.38 * d2.x, y: P3.y - len * 0.38 * d2.y };

    // the curve, then a gentle wave across it so limbs look grown, not drawn
    const N = 220;
    const base = Array.from({ length: N + 1 }, (_, i) => {
      const t = i / N, m = 1 - t;
      return {
        x: m * m * m * P0.x + 3 * m * m * t * P1.x + 3 * m * t * t * P2.x + t * t * t * P3.x,
        y: m * m * m * P0.y + 3 * m * m * t * P1.y + 3 * m * t * t * P2.y + t * t * t * P3.y,
      };
    });
    const amp = clamp(len * 0.03, 2.5, 14), freq = 1.4 + rnd() * 1.2, phase = rnd() * Math.PI * 2;
    const samples: { x: number; y: number; s: number }[] = [];
    let s = 0;
    base.forEach((p, i) => {
      const a = base[Math.max(0, i - 1)], c = base[Math.min(N, i + 1)];
      const dl = Math.hypot(c.x - a.x, c.y - a.y) || 1;
      const t = i / N;
      const off = Math.sin(t * Math.PI * freq + phase) * amp * Math.pow(Math.sin(Math.PI * t), 0.7);
      const x = p.x - ((c.y - a.y) / dl) * off, y = p.y + ((c.x - a.x) / dl) * off;
      if (samples.length) { const q = samples[samples.length - 1]; s += Math.hypot(x - q.x, y - q.y); }
      samples.push({ x, y, s });
    });
    const limb: Limb = {
      node, kind, depth, key, parent, angle, len: s, w, samples, tip: { x: 0, y: 0, tx: 0, ty: -1 },
      buckets: new Map(), el: null, box: null, kids: [],
      grow: new Tween(0), moss: new Tween(1), dying: false,
    };
    limb.tip = at(limb, limb.len);
    buildPixels(limb, rnd);
    return limb;
  }

  function at(b: Limb, s: number): Pt {
    const sm = b.samples;
    let lo = 0, hi = sm.length - 1;
    while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (sm[mid].s < s) lo = mid; else hi = mid; }
    const a = sm[lo], c = sm[hi];
    const u = c.s === a.s ? 0 : clamp((s - a.s) / (c.s - a.s), 0, 1);
    const dx = c.x - a.x, dy = c.y - a.y, dl = Math.hypot(dx, dy) || 1;
    return { x: lerp(a.x, c.x, u), y: lerp(a.y, c.y, u), tx: dx / dl, ty: dy / dl };
  }

  /* ---------- pixels: bark core, moss clumps, twigs, leafy tips ---------- */
  // Every limb is a full-grown, mossy limb: thick bark, moss clumps, leafy clumps,
  // twigs and a leafy crown at the tip.
  function buildPixels(b: Limb, rnd: () => number) {
    const cells = new Map<string, { color: string; p: Pix }>();
    const put = (x: number, y: number, color: string, s: number, moss: boolean, thr: number, need: number) => {
      const gx = Math.round(x / G), gy = Math.round(y / G), key = gx + ',' + gy;
      const had = cells.get(key);
      if (had) {
        if (!had.p.moss && moss) return; // bark wins over moss
        if (had.p.moss === moss && had.p.need <= need) return; // the earlier-appearing pixel wins
      }
      cells.set(key, { color, p: { gx, gy, s, thr, moss, need } });
    };

    const kk = k();
    const [w0, w1] = b.w;
    const thin = 0.24; // fraction of full width a sapling has
    const widthAt = (need: number) => lerp(thin, 1, need);
    const clumps = Array.from({ length: Math.ceil(b.len / 38) + 2 }, () => rnd());
    const clump = (s: number) => {
      const i = Math.floor(s / 38), f = s / 38 - i, u = f * f * (3 - 2 * f);
      return lerp(clumps[i], clumps[i + 1], u);
    };

    for (let s = 0; s <= b.len; s += 1.5) {
      const t = s / b.len;
      const p = at(b, s);
      const nx = -p.ty, ny = p.tx; // normal
      // the trunk flares where it meets the soil once it's old
      const flare = b.kind === 'trunk' ? 14 * kk * Math.pow(Math.max(0, 1 - t / 0.1), 2) : 0;
      const w = lerp(w0, w1, t) + flare;

      // bark: dark on the shaded side, light edge, grey middle, the odd red speck
      const shadeSide = nx > 0 ? 1 : -1; // the side facing right/down sits in shadow
      for (let kx = -w / 2; kx <= w / 2; kx += 1.4) {
        const need = clamp((Math.abs(kx) * 2 / w - thin) / (1 - thin), 0, 1);
        const r = rnd();
        let c = r < 0.55 ? BARK.mid : r < 0.8 ? BARK.light : BARK.dark;
        if (kx * shadeSide > 0 && rnd() < 0.25 + 0.6 * (Math.abs(kx) / (w / 2))) c = BARK.dark;
        if (rnd() < 0.008) c = BARK.speck;
        put(p.x + nx * kx, p.y + ny * kx, c, s, false, 0, need);
      }

      // moss: clumps that sit mostly on the upper side, thinning toward the tip. Old trees carry far more.
      const up = ny < 0 ? 1 : -1; // which normal direction points up the screen
      const m = clamp((clump(s) - 0.24) / 0.5, 0, 1);
      const count = Math.floor(m * 9 * (1 - t * 0.5) * (w0 / 14 + 0.4) + rnd() * 1.4);
      const R = lerp(w0 * 1.6 + 8, 4, t);
      for (let i = 0; i < count; i++) {
        const need = clamp(Math.pow(rnd(), 0.85) * 1.12 - 0.1, 0, 1);
        const sgn = rnd() < 0.72 ? up : -up;
        const off = sgn * ((w / 2) * widthAt(need) - 1 + Math.pow(rnd(), 1.15) * R * lerp(0.45, 1, need));
        const along = (rnd() - 0.5) * 5;
        put(p.x + nx * off + p.tx * along, p.y + ny * off + p.ty * along,
          leafFor(need, rnd(), rnd()), s + 8 + rnd() * 42, true, rnd(), need);
      }

      // foliage: leafy clumps along older limbs
      if (b.kind !== 'trunk' && t > 0.2 && rnd() < 0.02) {
        const need = 0.45 + rnd() * 0.55;
        const rr = (6 + rnd() * 8) * kk;
        const cxl = p.x + nx * up * (w / 2 + rr * 0.7), cyl = p.y + ny * up * (w / 2 + rr * 0.7);
        for (let q = 0; q < rr * rr * 0.9; q++) {
          const a = rnd() * Math.PI * 2, r = Math.sqrt(rnd()) * rr;
          put(cxl + Math.cos(a) * r, cyl + Math.sin(a) * r * 0.8, pickMoss(rnd()), s + 20 + r, true, rnd(),
            Math.min(1, need + (r / rr) * 0.2));
        }
      }

      // twigs: thin single-pixel offshoots that come with age
      if (t > 0.1 && t < 0.88 && rnd() < 0.026) {
        const need = 0.25 + rnd() * 0.75;
        const a = Math.atan2(p.ty, p.tx) + (rnd() < 0.5 ? -1 : 1) * (0.5 + rnd() * 0.6);
        const tl = (8 + rnd() * 20) * S;
        for (let j = 0; j < tl; j += 2) {
          if (rnd() < 0.85) put(p.x + Math.cos(a) * j, p.y + Math.sin(a) * j, BARK.light, s + j, false, 0, need);
        }
        for (let q = 0; q < 5; q++)
          put(p.x + Math.cos(a) * tl + (rnd() - 0.5) * 8, p.y + Math.sin(a) * tl + (rnd() - 0.5) * 8,
            pickMoss(rnd()), s + tl + 20, true, rnd() * 0.8, Math.min(1, need + 0.1));
      }
    }

    // a leafy tuft at every tip but the trunk's: a few fresh leaves on a sapling, a full crown when old
    if (b.kind !== 'trunk') {
      const tip = at(b, b.len);
      const Rt = (b.kind === 'folder' ? 26 : 20) * kk;
      for (let i = 0; i < Rt * Rt * 0.55; i++) {
        const a = rnd() * Math.PI * 2, r = Math.pow(rnd(), 0.7) * Rt;
        const need = clamp((r / Rt) * 0.95 - 0.12 + rnd() * 0.12, 0, 1);
        put(tip.x + Math.cos(a) * r, tip.y + Math.sin(a) * r * 0.8 - 3,
          leafFor(need, rnd(), rnd()), b.len * (1 - 0.03 * (1 - r / Rt)), true, rnd() * 0.9, need);
      }
    }

    for (const { color, p } of cells.values()) {
      if (!b.buckets.has(color)) b.buckets.set(color, []);
      b.buckets.get(color)!.push(p);
    }
  }

  /* ---------- the family-tree fan ---------- */
  const limbs: Limb[] = []; // everything drawn, including limbs pulling back in
  const open: Limb[] = []; // open folders: trunk first, deepest last
  const placed: Box[] = []; // label boxes, so labels avoid each other
  const cam = { x: new Tween(0), y: new Tween(0) };
  let planted = false;

  // Angles (from straight up) for n children. Folders take the middle and keep climbing;
  // pages spread out to the sides on the same level.
  function fanFor(kids: TreeNode[], depth: number): number[] {
    const n = kids.length;
    const spread = narrow ? 1.05 : 1.2; // radians from straight up
    let slots: number[];
    if (n === 1) slots = [0];
    else if (n === 2 && kids.some((c) => c.kind === 'folder')) slots = [0, (depth % 2 ? -1 : 1) * spread];
    else slots = Array.from({ length: n }, (_, i) => lerp(-spread, spread, i / (n - 1)));
    // folders first into the slots nearest the middle, then pages outward
    const order = kids.map((c, i) => i).sort((a, b) =>
      (kids[a].kind === 'folder' ? 0 : 1) - (kids[b].kind === 'folder' ? 0 : 1) || a - b);
    const bySlot = [...slots].sort((a, b) => Math.abs(a) - Math.abs(b) || a - b);
    const out: number[] = [];
    order.forEach((kidIndex, i) => (out[kidIndex] = bySlot[i]));
    return out;
  }

  function spawnKids(f: Limb, instant: boolean, delay = 0) {
    const kids = f.node.children ?? [];
    const slots = fanFor(kids, f.depth);
    const tipAngle = Math.atan2(f.tip.ty, f.tip.tx);
    const base = lerp(UP, tipAngle, 0.3);
    const made: Limb[] = kids.map((node, i) => {
      const kind: Kind = node.kind === 'folder' ? 'folder' : 'file';
      const limb = makeLimb(node, kind, f.depth + 1, `${f.key}/${node.name}`, f,
        { x: f.tip.x, y: f.tip.y }, base + slots[i], Math.abs(slots[i]) < 0.2);
      return limb;
    });
    f.kids = made;
    limbs.push(...made);
    // labels go on once every sibling limb exists, so they can steer clear of all of them
    made
      .map((l, i) => ({ l, slot: slots[i] }))
      .sort((a, b) => a.slot - b.slot) // left to right, which is also the Tab order
      .forEach(({ l, slot }) => {
        makeLabel(l);
        // the middle limb leads; the side limbs follow a beat later
        if (instant) l.grow.set(1);
        else l.grow.go(1, growTime(l), easeOut, delay + 0.07 * Math.round(Math.abs(slot) * 2));
      });
  }

  function growTime(b: Limb) { return 0.5 + b.len / 1600; }

  // Does a label box sit on any limb, or on another label?
  function blocked(r: Box) {
    for (const q of placed) if (r.x0 < q.x1 && r.x1 > q.x0 && r.y0 < q.y1 && r.y1 > q.y0) return true;
    for (const l of limbs) {
      if (l.dying) continue;
      const sm = l.samples;
      for (let i = 0; i < sm.length; i += 2) {
        const p = sm[i];
        if (p.x > r.x0 - 4 && p.x < r.x1 + 4 && p.y > r.y0 - 5 && p.y < r.y1 + 5) return true;
      }
    }
    return false;
  }

  function makeLabel(l: Limb) {
    const isFolder = l.kind === 'folder';
    const el = document.createElement(isFolder ? 'button' : 'a');
    el.className = 'tnode';
    el.innerHTML = (isFolder ? ICON.closed + ICON.open : ICON.file) +
      `<span class="label">${l.node.name}${isFolder ? '/' : ''}</span>`;
    const { x, y } = l.tip;
    const lw = (l.node.name.length + (isFolder ? 1 : 0)) * 6.7 + 4;
    const right: Box = { x0: x + 10, x1: x + 14 + lw, y0: y - 8, y1: y + 8 };
    const left: Box = { x0: x - 14 - lw, x1: x - 10, y0: y - 8, y1: y + 8 };
    const below: Box = { x0: x + 18, x1: x + 22 + lw, y0: y + 9, y1: y + 23 };
    const above: Box = { x0: x + 18, x1: x + 22 + lw, y0: y - 17, y1: y - 3 };
    const over: Box = { x0: x - lw / 2 - 2, x1: x + lw / 2 + 2, y0: y - 30, y1: y - 13 }; // centred above the icon
    // Folders keep their label below, out of the way of the limbs they'll grow.
    // Pages read outward: label right on the right side, left on the left.
    // On phones, pages out on the sides put their label above the icon so it can't run off the screen.
    const leansLeft = Math.cos(l.angle) < -0.2, onSide = Math.abs(Math.cos(l.angle)) > 0.2;
    const outward: [string, Box][] = leansLeft ? [['flip', left], ['', right]] : [['', right], ['flip', left]];
    const tries: [string, Box][] = isFolder
      ? [['label-below', below], ['label-above', above], ['', right], ['flip', left]]
      : narrow && onSide ? [['label-over', over], ...outward] : [...outward, ['label-over', over], ['label-below', below]];
    const pick = tries.find(([, b]) => !blocked(b)) ?? tries[0];
    if (pick[0]) el.classList.add(pick[0]);
    l.box = pick[1];
    placed.push(pick[1]);

    const flip = pick[0] === 'flip';
    el.style.left = `${Math.round(flip ? x + 24 : x - 8)}px`;
    el.style.top = `${Math.round(y - 8)}px`;
    el.tabIndex = -1;
    if (isFolder) {
      el.setAttribute('type', 'button');
      el.setAttribute('aria-expanded', 'false');
      el.addEventListener('click', () => toggle(l));
    } else {
      (el as HTMLAnchorElement).href = l.node.href!;
    }
    world.appendChild(el);
    l.el = el;
  }

  /* ---------- opening and closing ---------- */
  function openFolder(f: Limb, instant = false) {
    closeBelow(open.indexOf(f.parent!));
    open.push(f);
    f.el?.setAttribute('aria-expanded', 'true');
    spawnKids(f, instant);
    refocus(instant);
  }

  // Pull back every limb grown from folders deeper than `index` in the open path.
  function closeBelow(index: number) {
    while (open.length > index + 1) {
      const f = open.pop()!;
      f.el?.setAttribute('aria-expanded', 'false');
      for (const kid of f.kids) {
        kid.dying = true;
        kid.grow.go(0, 0.4, easeIn);
        if (kid.box) placed.splice(placed.indexOf(kid.box), 1);
        if (kid.el) { kid.el.tabIndex = -1; kid.el.classList.remove('shown'); }
      }
      f.kids = [];
    }
  }

  function toggle(f: Limb) {
    const i = open.indexOf(f);
    if (i === -1) openFolder(f);
    else { closeBelow(i - 1); refocus(); }
  }

  // The newest level is in focus; levels below it thin out, as in the reference.
  function refocus(instant = false) {
    const deepest = open[open.length - 1];
    for (const l of limbs) {
      if (l.dying) continue;
      const active = l.parent === deepest || l === deepest;
      const target = active ? 1 : 0.42;
      instant ? l.moss.set(target) : l.moss.go(target, 0.5);
      l.el?.classList.toggle('dim', !active && l.el.getAttribute('aria-expanded') !== 'true');
    }
    frame(deepest, instant);
    updateChrome();
  }

  /* ---------- camera ---------- */
  const headerSpace = () => (W < 700 ? 72 : 88);
  function frame(f: Limb, instant = false) {
    let tx: number, ty: number;
    if (!planted) {
      tx = -W / 2; ty = -(H * 0.62); // just the pot, a little below centre
    } else {
      // fit the open folder's fork and everything growing from it
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      const fit = (x0: number, y0: number, x1: number, y1: number) => {
        minX = Math.min(minX, x0); minY = Math.min(minY, y0); maxX = Math.max(maxX, x1); maxY = Math.max(maxY, y1);
      };
      const grp = f.kind === 'trunk' ? [f, ...f.kids] : [...f.kids];
      fit(f.tip.x - 30, f.tip.y - 10, f.tip.x + 30, f.tip.y + 40);
      for (const l of grp) {
        for (const p of l.samples) fit(p.x, p.y, p.x, p.y);
        if (l.kind !== 'trunk') fit(l.tip.x - 30, l.tip.y - 30, l.tip.x + 30, l.tip.y + 20);
        if (l.box) fit(l.box.x0, l.box.y0, l.box.x1, l.box.y1);
      }
      if (f.kind === 'trunk') fit(-14 * PG, 0, 14 * PG, potBottom() + 8);
      const pad = W < 700 ? 16 : 72, top = headerSpace(), bottom = 56;
      const vw = W - pad * 2, vh = H - top - bottom;
      tx = maxX - minX <= vw ? (minX + maxX) / 2 - W / 2 : minX - pad;
      ty = maxY - minY <= vh ? (minY + maxY) / 2 - (top + vh / 2) : minY - top;
    }
    if (instant) { cam.x.set(tx); cam.y.set(ty); }
    else { cam.x.go(tx, 0.65); cam.y.go(ty, 0.65); }
  }

  /* ---------- chrome: path and item count ---------- */
  function updateChrome() {
    pathEl.innerHTML = '';
    open.forEach((f, i) => {
      if (i) pathEl.insertAdjacentHTML('beforeend', '<span class="sep">/</span>');
      const last = i === open.length - 1;
      const seg = document.createElement(last ? 'span' : 'button');
      seg.textContent = f.node.name;
      if (!last) {
        seg.setAttribute('type', 'button');
        seg.addEventListener('click', () => { closeBelow(i); refocus(); });
      } else seg.setAttribute('aria-current', 'location');
      pathEl.appendChild(seg);
    });
    if (!planted) { countEl.textContent = coarse ? 'Tap the pot' : 'Click the pot'; return; }
    const n = open[open.length - 1].node.children?.length ?? 0;
    countEl.textContent = `${n} item${n === 1 ? '' : 's'}`;
    history.replaceState(null, '', `#/${open.slice(1).map((f) => f.node.name).join('/')}`);
  }

  /* ---------- render loop ---------- */
  let raf = 0;
  function wake() { if (!raf) raf = requestAnimationFrame(draw); }

  function draw(now: number) {
    raf = 0;
    let busy = cam.x.tick(now) | cam.y.tick(now) | potLift.tick(now) ? true : false;
    for (const l of limbs) busy = l.grow.tick(now) || l.moss.tick(now) || busy;

    const cx = Math.round(cam.x.v), cy = Math.round(cam.y.v);
    world.style.transform = `translate(${-cx}px, ${-cy}px)`;
    ctx.clearRect(0, 0, W, H);

    for (let i = limbs.length - 1; i >= 0; i--) {
      const l = limbs[i];
      if (l.dying && l.grow.v <= 0) { l.el?.remove(); limbs.splice(i, 1); }
    }
    for (const l of limbs) paint(l, cx, cy);
    paintPot(cx, cy);

    if (busy) wake();
  }

  function paint(l: Limb, cx: number, cy: number) {
    const reach = l.grow.v * l.len;
    const moss = l.moss.v * (l.dying ? l.grow.v : 1);
    for (const [color, pix] of l.buckets) {
      ctx.fillStyle = color;
      for (const p of pix) {
        if (p.s > reach) continue;
        if (p.moss && p.thr > moss) continue;
        const x = p.gx * G - cx, y = p.gy * G - cy;
        if (x < -G || y < -G || x > W || y > H) continue;
        ctx.fillRect(x, y, G, G);
      }
    }
    if (l.el && !l.dying) {
      const shown = l.grow.v > 0.88;
      if (shown !== l.el.classList.contains('shown')) {
        l.el.classList.toggle('shown', shown);
        l.el.tabIndex = shown ? 0 : -1;
      }
    }
  }

  /* ---------- the pot ---------- */
  // Pixel art in grid cells, origin at the centre of the soil. y grows downward.
  let PG = 3; // the pot's pixel size: a touch chunkier on big screens, where it's alone on the page
  const potBottom = () => 21 * PG;
  const POT = {
    light: C('pot-light'), mid: C('pot'), shade: C('pot-shade'), line: C('pot-line'), soil: C('soil'),
  };
  const potPixels: [number, number, string][] = [];
  (() => {
    const rnd = rngFrom(hash('pot'));
    const fill = (x: number, y: number, hw: number) => {
      const u = (x + hw) / (2 * hw), d = (x + y) & 1;
      if (u < 0.22 || (u < 0.3 && d)) return POT.light;
      if (u > 0.74 || (u > 0.66 && d)) return POT.shade;
      return POT.mid;
    };
    for (let x = -11; x <= 11; x++) potPixels.push([x, -1, POT.line]); // back lip
    for (let x = -12; x <= 12; x++) // soil, with a few moss specks
      potPixels.push([x, 0, Math.abs(x) === 12 ? POT.line : rnd() < 0.12 ? pickMoss(rnd()) : POT.soil]);
    for (let y = 1; y <= 4; y++) for (let x = -13; x <= 13; x++)
      potPixels.push([x, y, y === 1 || y === 4 || Math.abs(x) === 13 ? POT.line : fill(x, y, 13)]);
    for (let y = 5; y <= 20; y++) {
      const hw = Math.round(lerp(11, 8, (y - 5) / 15));
      for (let x = -hw; x <= hw; x++) potPixels.push([x, y, Math.abs(x) === hw ? POT.line : fill(x, y, hw)]);
    }
    for (let x = -8; x <= 8; x++) potPixels.push([x, 21, POT.line]);
  })();
  // A sprout waits in the soil until the pot is clicked; it perks up on hover.
  const SPROUT: [number, number, number][] = [
    [0, -1, 2], [0, -2, 2], [0, -3, 2], [-1, -3, 0], [-2, -4, 0], [1, -4, 1], [2, -5, 1], [-1, -4, 3],
  ];
  const SPROUT_HOVER: [number, number, number][] = [[0, -4, 2], [0, -5, 0], [-1, -6, 1], [1, -6, 4], [-3, -5, 0], [3, -6, 1]];
  const potLift = new Tween(0);
  let potHover = false;

  function paintPot(cx: number, cy: number) {
    const lift = Math.round(potLift.v);
    for (const [x, y, c] of potPixels) { ctx.fillStyle = c; ctx.fillRect(x * PG - cx, y * PG - cy + lift, PG, PG); }
    if (planted) return;
    for (const [x, y, i] of potHover ? [...SPROUT, ...SPROUT_HOVER] : SPROUT) {
      ctx.fillStyle = MOSS[i][0];
      ctx.fillRect(x * PG - cx, y * PG - cy + lift, PG, PG);
    }
  }

  let potBtn: HTMLButtonElement;
  function makePotButton() {
    potBtn = document.createElement('button');
    potBtn.type = 'button';
    potBtn.className = 'pot-btn';
    potBtn.style.left = `${-16 * PG}px`;
    potBtn.style.top = `${-9 * PG}px`;
    potBtn.style.width = `${32 * PG}px`;
    potBtn.style.height = `${32 * PG}px`;
    const hover = (on: boolean) => { potHover = on; wake(); };
    potBtn.addEventListener('pointerenter', () => hover(true));
    potBtn.addEventListener('pointerleave', () => hover(false));
    potBtn.addEventListener('focus', () => hover(true));
    potBtn.addEventListener('blur', () => hover(false));
    potBtn.addEventListener('click', () => {
      potLift.go(-4, 0.1);
      setTimeout(() => potLift.go(0, 0.35), 100);
      if (!planted) growTree();
      else if (open.length > 1) { closeBelow(0); refocus(); } // the pot also takes you back to the top
    });
    world.appendChild(potBtn);
    labelPot();
  }
  function labelPot() {
    potBtn.setAttribute('aria-label', planted ? 'Back to the top of the tree' : 'Grow the tree');
  }

  function growTree() {
    planted = true;
    labelPot();
    const trunk = open[0];
    const t = growTime(trunk);
    trunk.grow.go(1, t);
    spawnKids(trunk, false, t * 0.72); // the first fork opens as the trunk tops out
    refocus();
  }

  /* ---------- setup ---------- */
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight; S = clamp(W / 1200, 0.62, 1);
    narrow = W < 700;
    PG = W >= 760 ? 4 : 3;
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function plant(path: string[]) {
    world.innerHTML = '';
    limbs.length = 0; open.length = 0; placed.length = 0;
    const trunk = makeLimb(data, 'trunk', 0, 'evan', null, { x: 0, y: -PG }, UP, true);
    limbs.push(trunk);
    open.push(trunk);
    makePotButton();
    if (planted) {
      trunk.grow.set(1);
      spawnKids(trunk, true);
      let f = trunk;
      for (const name of path) {
        const next = f.kids.find((l) => l.kind === 'folder' && l.node.name === name);
        if (!next) break;
        openFolder(next, true);
        f = next;
      }
    }
    refocus(true);
  }

  // "#/…" in the address means the tree is already grown (e.g. coming back from a page).
  const readHash = () => ({
    grown: location.hash.startsWith('#/'),
    path: decodeURIComponent(location.hash.replace(/^#\/?/, '')).split('/').filter(Boolean),
  });

  document.documentElement.classList.add('js');
  resize();
  const start = readHash();
  planted = start.grown;
  plant(start.path);
  wake();

  let resizeTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      const path = open.slice(1).map((f) => f.node.name);
      resize(); plant(path); wake();
    }, 150);
  });

  // A link to another folder on this page (e.g. /#/work) replants the tree there.
  addEventListener('hashchange', () => {
    const next = readHash();
    if (!next.grown) return;
    planted = true; plant(next.path); wake();
  });

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open.length > 1) { closeBelow(open.length - 2); refocus(); }
  });
</script>
