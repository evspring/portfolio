---
/*
  The site's one signature thing: six light segments, the same six sections
  a Velocity 360 step exposes in Sequence. It plays light patterns the way the
  app does. Click/tap it to change the pattern.
*/
const patterns = ['chase', 'breathe', 'wave'] as const;
---

<button
  type="button"
  class="light-strip group"
  data-pattern="chase"
  aria-label="Change the light pattern"
  data-patterns={patterns.join(',')}
>
  {Array.from({ length: 6 }, (_, i) => (
    <span class="seg" style={`--i:${i}; --c: var(--color-light-${i + 1})`} />
  ))}
  <span class="caption" aria-live="polite">Chase</span>
</button>

<style>
  .light-strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    width: 100%;
    max-width: 30rem;
    text-align: left;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Each segment is an unlit step section (mat gray) with its light layered on top */
  .seg {
    position: relative;
    height: 12px;
    border-radius: 999px;
    background: var(--color-mat);
  }
  .seg::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--c);
    opacity: 0;
  }

  .caption {
    position: absolute;
    left: 0;
    top: calc(100% + 10px);
    font-size: var(--text-sm);
    color: var(--color-quiet);
  }

  /* chase: one light glides down the step. Driven by the script below, with
     the motion measured from Basit's reel: a kick every 3.6s (fast attack,
     long settle) and a slow creep that never quite stops. */
  [data-pattern='chase'] .seg::after {
    opacity: var(--lit, 0);
    box-shadow: 0 0 calc(var(--lit, 0) * 20px) calc(var(--lit, 0) * -2px) var(--c);
  }

  /* breathe: every section together, slow */
  [data-pattern='breathe'] .seg::after {
    animation: breathe 3.2s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { opacity: 0.15; box-shadow: none; }
    50% { opacity: 1; box-shadow: 0 0 22px -4px var(--c); }
  }

  /* wave: a swell that crosses the whole step */
  [data-pattern='wave'] .seg::after {
    animation: wave 1.8s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 0.12s);
  }
  @keyframes wave {
    from { opacity: 0.1; transform: scaleY(1); }
    to { opacity: 1; transform: scaleY(1.6); box-shadow: 0 0 16px -4px var(--c); }
  }

  @media (prefers-reduced-motion: reduce) {
    .seg::after { opacity: 1 !important; animation: none !important; }
  }
</style>

<script>
  // Motion profile measured from Basit's reel (carousel speed tracked frame by frame):
  // one step every 3.6s, ~70% of it in a kick that peaks ~0.4s in and settles over ~2s,
  // the rest a constant creep, so the light is never fully still.
  const CYCLE = 3.6, KICK = 2.8, KICK_SHARE = 0.7;
  const smooth = (u: number) => u * u * (3 - 2 * u);
  const settle = (u: number) => 1 - Math.pow(1 - smooth(u), 3.5);
  const position = (t: number) => {
    const step = Math.floor(t / CYCLE), local = t - step * CYCLE;
    return step + KICK_SHARE * settle(Math.min(local / KICK, 1)) + (1 - KICK_SHARE) * (local / CYCLE);
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLButtonElement>('.light-strip').forEach((strip) => {
    const segs = [...strip.querySelectorAll<HTMLElement>('.seg')];
    const start = performance.now();
    const tick = (now: number) => {
      if (strip.dataset.pattern === 'chase' && !reduced) {
        const pos = position((now - start) / 1000) % segs.length;
        segs.forEach((seg, i) => {
          let d = Math.abs(i - pos);
          d = Math.min(d, segs.length - d); // wrap from the last section back to the first
          seg.style.setProperty('--lit', Math.max(0, 1 - d / 0.9).toFixed(3));
        });
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    const list = (strip.dataset.patterns ?? 'chase').split(',');
    const caption = strip.querySelector('.caption')!;
    strip.addEventListener('click', () => {
      const next = list[(list.indexOf(strip.dataset.pattern!) + 1) % list.length];
      strip.dataset.pattern = next;
      caption.textContent = next[0].toUpperCase() + next.slice(1);
    });
  });
</script>
