---
interface Props {
  /** Plain paper: one solid colour and a faint grain, no glows or streaks. */
  plain?: boolean;
}
const { plain = false } = Astro.props;
/*
  The sky behind every page: warm paper, a rose glow up high, a sage glow down low, a few faint
  upright washes like distant trunks, and paper grain over everything.

  It's the same on every page and it never moves, so when the view pans between the tree and a
  page, the sky holds still and only the tree and the page travel. Drawn by an inline script at
  the top of <body>, before the first frame, so nothing pops in.
*/
---

<canvas class="paper-sky" aria-hidden="true" data-plain={plain ? '' : undefined}></canvas>
<canvas class="paper-grain" aria-hidden="true" data-plain={plain ? '' : undefined}></canvas>
<script is:inline>
  (function () {
    var sky = document.querySelector('.paper-sky'), grain = document.querySelector('.paper-grain');
    var css = getComputedStyle(document.documentElement);
    var C = function (n) { return css.getPropertyValue('--color-' + n).trim(); };
    // the same seeded randomness as the tree, so the streaks land in the same places everywhere
    var hash = function (s) { var h = 2166136261; for (var i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619); return h >>> 0; };
    var rngFrom = function (seed) {
      return function () {
        seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
        var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    };
    function draw() {
      var W = innerWidth, H = innerHeight, DPR = Math.min(devicePixelRatio || 1, 2);
      var rnd = rngFrom(hash('paper'));
      sky.width = Math.round(W * DPR); sky.height = Math.round(H * DPR);
      var b = sky.getContext('2d');
      b.setTransform(DPR, 0, 0, DPR, 0, 0);
      b.fillStyle = C('paper'); b.fillRect(0, 0, W, H);
      if (sky.hasAttribute('data-plain')) { drawGrain(rnd, W, H, DPR); return; }
      var glow = function (x, y, r, col, a) {
        var g = b.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, col); g.addColorStop(1, 'rgba(255,255,255,0)');
        b.globalAlpha = a; b.fillStyle = g; b.fillRect(0, 0, W, H);
      };
      glow(W * 0.82, H * 0.08, Math.max(W, H) * 0.7, C('wash-rose'), 0.42);
      glow(W * 0.1, H * 1.0, Math.max(W, H) * 0.6, C('leaf-mint'), 0.5);
      var n = Math.round(W / 220);
      for (var i = 0; i < n; i++) {
        var x = (i + 0.2 + rnd() * 0.6) * (W / n), w = 14 + rnd() * 46;
        var g = b.createLinearGradient(x - w / 2, 0, x + w / 2, 0);
        g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(0.5, C('wash-rose')); g.addColorStop(1, 'rgba(255,255,255,0)');
        b.globalAlpha = 0.1 + rnd() * 0.1; b.fillStyle = g;
        b.fillRect(x - w / 2, 0, w, H * (0.55 + rnd() * 0.45));
      }
      b.globalAlpha = 1;
      drawGrain(rnd, W, H, DPR);
    }
    // grain: soft speckle, multiplied over everything
    function drawGrain(rnd, W, H, DPR) {
      var tile = document.createElement('canvas'); tile.width = tile.height = 160;
      var t = tile.getContext('2d'), img = t.createImageData(160, 160);
      for (var j = 0; j < img.data.length; j += 4) {
        var v = 255 - Math.floor(Math.pow(rnd(), 3) * 46);
        img.data[j] = v; img.data[j + 1] = v - 2; img.data[j + 2] = v - 6; img.data[j + 3] = 255;
      }
      t.putImageData(img, 0, 0);
      grain.width = Math.round(W * DPR); grain.height = Math.round(H * DPR);
      var gg = grain.getContext('2d');
      gg.fillStyle = gg.createPattern(tile, 'repeat'); gg.fillRect(0, 0, grain.width, grain.height);
    }
    draw();
    var timer = 0;
    addEventListener('resize', function () { clearTimeout(timer); timer = setTimeout(draw, 150); });
  })();
</script>

<style is:global>
  .paper-sky, .paper-grain { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .paper-sky { z-index: -1; }
  .paper-grain { z-index: 30; mix-blend-mode: multiply; opacity: 0.5; }
  .paper-grain[data-plain] { opacity: 0.22; }
</style>
