---
import '../styles/global.css';

import { EMAIL } from '../data/tree';
import PaperSky from '../components/PaperSky.astro';

interface Props {
  title?: string;
  description?: string;
  /** Bare pages (the home tree) supply their own chrome. */
  bare?: boolean;
  /** Where "Back" returns to: the tree, opened to this page's folder. */
  back?: string;
}

const {
  title = 'Evan Springer — Product designer',
  description = 'Evan Springer is a product designer who helps teams shape and build apps and products.',
  bare = false,
  back = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f0ea" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!--
      The pan between the tree and a page. Set up before the first frame: a page we're panning
      up into starts above the screen; the tree we're returning to starts hidden below.
    -->
    <script is:inline>
      (function () {
        try {
          var d = JSON.parse(sessionStorage.getItem('tree-pan') || 'null');
          if (!d || Date.now() - d.at > 4000 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var here = location.pathname;
          if (d.way === 'in' && d.href === here) document.documentElement.classList.add('pan-arrive');
          if (d.way === 'out' && here === '/') document.documentElement.classList.add('pan-return');
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <PaperSky />
    {bare ? (
      <slot />
    ) : (
      <div class="pan-content">
        <header class="mx-auto flex max-w-[68rem] items-center justify-between px-5 pt-6 sm:px-8">
          <a href="/" class="text-sm font-medium no-underline">Evan Springer</a>
          <a href={back} class="text-sm text-quiet no-underline hover:text-ink" data-back>Back to the tree</a>
        </header>

        <!--
          The pan, page side. Arriving from the tree, the page slides down into place (see
          global.css). "Back to the tree" lifts the page away upward, then the tree rises into view.
        -->
        <script is:inline>
          (function () {
            var root = document.documentElement, KEY = 'tree-pan';
            var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
            try { sessionStorage.removeItem(KEY); } catch (e) {}
            var content = document.currentScript.closest('.pan-content');
            if (root.classList.contains('pan-arrive')) {
              var done = function () { root.classList.remove('pan-arrive'); };
              content.addEventListener('animationend', done, { once: true });
              setTimeout(done, 1200);
            }
            document.addEventListener('click', function (e) {
              var a = e.target.closest && e.target.closest('[data-back]');
              if (!a || reduced || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
              e.preventDefault();
              try { sessionStorage.setItem(KEY, JSON.stringify({ way: 'out', href: location.pathname, at: Date.now() })); } catch (err) {}
              root.classList.add('pan-leave');
              content.addEventListener('animationend', function () { location.href = a.href; }, { once: true });
            });
            addEventListener('pageshow', function (e) {
              if (e.persisted) root.classList.remove('pan-arrive', 'pan-leave');
            });
          })();
        </script>

        <main class="mx-auto max-w-[68rem] px-5 sm:px-8">
          <slot />
        </main>

        <footer class="mx-auto mt-32 flex max-w-[68rem] justify-between border-t border-rule px-5 py-8 text-sm text-quiet sm:px-8">
          <span>© {new Date().getFullYear()} Evan Springer</span>
          <a href={`mailto:${EMAIL}`} class="no-underline hover:text-ink">{EMAIL}</a>
        </footer>
      </div>
    )}
  </body>
</html>
