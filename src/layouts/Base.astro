---
import '../styles/global.css';

import { EMAIL } from '../data/tree';
import PaperSky from '../components/PaperSky.astro';

interface Props {
  title?: string;
  description?: string;
  /** Bare pages (the home tree) supply their own chrome. */
  bare?: boolean;
  /** Where "Back" returns to: the tree, opened to this page's folder. */
  back?: string;
  /** Plain, solid paper behind the page (no glows or streaks). */
  plain?: boolean;
}

const {
  title = 'Evan Springer — Product designer',
  description = 'Evan Springer is a product designer who helps teams shape and build apps and products.',
  bare = false,
  back = '/',
  plain = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f0ea" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!-- hold the first paint until the piece that pans in has been read in, so the pan can carry it -->
    <link rel="expect" href={bare ? '#tree-data' : '#doc-end'} blocking="render" />
    <!-- tell the next page how far down this one was scrolled, so the pan carries the right slice -->
    <script is:inline>
      addEventListener('pageswap', function () { try { sessionStorage.setItem('vt-scroll', String(scrollY)); } catch (e) {} });
      addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        try { document.documentElement.style.setProperty('--vt-scroll', (sessionStorage.getItem('vt-scroll') || 0) + 'px'); } catch (err) {}
      });
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <PaperSky plain={plain} />
    {bare ? (
      <slot />
    ) : (
      <div class="pan-content">
        <header class="mx-auto flex max-w-[68rem] items-center justify-between px-5 pt-6 sm:px-8">
          <a href="/" class="text-sm font-medium no-underline">Evan Springer</a>
          <a href={back} class="text-sm text-quiet no-underline hover:text-ink" data-back>Back to the tree</a>
        </header>



        <main class="mx-auto max-w-[68rem] px-5 sm:px-8">
          <slot />
        </main>

        <footer class="mx-auto mt-32 flex max-w-[68rem] justify-between border-t border-rule px-5 py-8 text-sm text-quiet sm:px-8">
          <span>© {new Date().getFullYear()} Evan Springer</span>
          <a href={`mailto:${EMAIL}`} class="no-underline hover:text-ink">{EMAIL}</a>
        </footer>
        <span id="doc-end" hidden></span>
      </div>
    )}
  </body>
</html>
