---
import '../styles/global.css';

import { EMAIL } from '../data/tree';

interface Props {
  title?: string;
  description?: string;
  /** Bare pages (the home tree) supply their own chrome. */
  bare?: boolean;
  /** Where "Back" returns to: the tree, opened to this page's folder. */
  back?: string;
}

const {
  title = 'Evan Springer — Product designer',
  description = 'Evan Springer is a product designer who helps teams shape and build apps and products.',
  bare = false,
  back = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    {bare ? (
      <slot />
    ) : (
      <>
        <header class="mx-auto flex max-w-[68rem] items-center justify-between px-5 pt-6 sm:px-8">
          <a href="/" class="text-sm font-medium no-underline">Evan Springer</a>
          <a href={back} class="text-sm text-quiet no-underline hover:text-ink" data-back>Back to the tree</a>
        </header>

        <!--
          The canopy transition, page side. Arriving from the tree: the canopy's colour fills the
          screen, then dissolves to reveal the page. Going back: the colour gathers again, and the
          tree flows it back into the canopy you came from.
        -->
        <script is:inline>
          (function () {
            var KEY = 'tree-veil', d = null;
            var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
            try { d = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) {}
            var fresh = d && d.way === 'in' && Date.now() - d.at < 4000 && d.href === location.pathname;
            var paint = function (el, c) {
              el.className = 'page-veil';
              el.style.background = 'radial-gradient(circle at 50% 50%, ' + c.deep + ' 0%, ' + c.deep + ' 34%, ' + c.light + ' 100%)';
              return el;
            };
            if (fresh && !reduced) {
              var v = paint(document.createElement('div'), d);
              v.classList.add('arrive');
              document.body.appendChild(v);
              v.addEventListener('animationend', function () { v.remove(); });
            }
            // remember this page's colours for the way back
            var colours = fresh ? d : null;
            document.addEventListener('click', function (e) {
              var a = e.target.closest && e.target.closest('[data-back]');
              if (!a || !colours || reduced || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
              e.preventDefault();
              try { sessionStorage.setItem(KEY, JSON.stringify({ light: colours.light, deep: colours.deep, href: location.pathname, at: Date.now(), way: 'out' })); } catch (err) {}
              var v = paint(document.createElement('div'), colours);
              v.classList.add('leave');
              document.body.appendChild(v);
              v.addEventListener('animationend', function () { location.href = a.href; });
            });
            addEventListener('pageshow', function (e) {
              if (e.persisted) document.querySelectorAll('.page-veil').forEach(function (n) { n.remove(); });
            });
            try { if (fresh) sessionStorage.removeItem(KEY); } catch (e) {}
          })();
        </script>

        <main class="mx-auto max-w-[68rem] px-5 sm:px-8">
          <slot />
        </main>

        <footer class="mx-auto mt-32 flex max-w-[68rem] justify-between border-t border-rule px-5 py-8 text-sm text-quiet sm:px-8">
          <span>© {new Date().getFullYear()} Evan Springer</span>
          <a href={`mailto:${EMAIL}`} class="no-underline hover:text-ink">{EMAIL}</a>
        </footer>
      </>
    )}
  </body>
</html>
