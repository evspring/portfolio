---
import '../styles/global.css';

import { EMAIL } from '../data/tree';

interface Props {
  title?: string;
  description?: string;
  /** Bare pages (the home tree) supply their own chrome. */
  bare?: boolean;
  /** Where "Back" returns to: the tree, opened to this page's folder. */
  back?: string;
}

const {
  title = 'Evan Springer — Product designer',
  description = 'Evan Springer is a product designer who helps teams shape and build apps and products.',
  bare = false,
  back = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f0ea" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!--
      The canopy transition: if we're arriving from the tree (or returning to it), put up the
      same colour wash before the first frame so the handoff has no seam.
    -->
    <script is:inline>
      (function () {
        try {
          var d = JSON.parse(sessionStorage.getItem('tree-veil') || 'null');
          if (!d || Date.now() - d.at > 4000 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var here = location.pathname;
          if (!((d.way === 'in' && d.href === here) || (d.way === 'out' && here === '/'))) return;
          var s = document.documentElement.style;
          s.setProperty('--veil-deep', d.deep);
          s.setProperty('--veil-light', d.light);
          s.setProperty('--veil-r', Math.hypot(innerWidth, innerHeight) * 1.15 * 0.62 + 'px');
          document.documentElement.classList.add('veil-on');
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['min-h-screen', !bare && 'paper-page']}>
    {bare ? (
      <slot />
    ) : (
      <>
        <header class="mx-auto flex max-w-[68rem] items-center justify-between px-5 pt-6 sm:px-8">
          <a href="/" class="text-sm font-medium no-underline">Evan Springer</a>
          <a href={back} class="text-sm text-quiet no-underline hover:text-ink" data-back>Back to the tree</a>
        </header>

        <!--
          The canopy transition, page side. Arriving from the tree: the canopy's colour fills the
          screen, then dissolves to reveal the page. Going back: the colour gathers again, and the
          tree flows it back into the canopy you came from.
        -->
        <script is:inline>
          (function () {
            var KEY = 'tree-veil', root = document.documentElement, d = null;
            var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
            try { d = JSON.parse(sessionStorage.getItem(KEY) || 'null'); sessionStorage.removeItem(KEY); } catch (e) {}
            var colours = d && d.way === 'in' && d.href === location.pathname ? d : null;
            // arriving: the wash is already up (see <head>); let it dissolve
            if (root.classList.contains('veil-on')) {
              var end = function () { root.classList.remove('veil-on', 'veil-out'); };
              requestAnimationFrame(function () {
                root.classList.add('veil-out');
                document.body.addEventListener('animationend', end, { once: true });
                setTimeout(end, 1400); // in case the animation event never comes
              });
            }
            // going back: gather the colour, then hand it to the tree
            document.addEventListener('click', function (e) {
              var a = e.target.closest && e.target.closest('[data-back]');
              if (!a || !colours || reduced || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
              e.preventDefault();
              try { sessionStorage.setItem(KEY, JSON.stringify({ light: colours.light, deep: colours.deep, href: location.pathname, at: Date.now(), way: 'out' })); } catch (err) {}
              root.style.setProperty('--veil-deep', colours.deep);
              root.style.setProperty('--veil-light', colours.light);
              root.style.setProperty('--veil-r', Math.hypot(innerWidth, innerHeight) * 1.15 * 0.62 + 'px');
              root.classList.remove('veil-out');
              root.classList.add('veil-on', 'veil-in');
              document.body.addEventListener('animationend', function () { location.href = a.href; }, { once: true });
            });
            addEventListener('pageshow', function (e) {
              if (e.persisted) root.classList.remove('veil-on', 'veil-in', 'veil-out');
            });
          })();
        </script>

        <main class="mx-auto max-w-[68rem] px-5 sm:px-8">
          <slot />
        </main>

        <footer class="mx-auto mt-32 flex max-w-[68rem] justify-between border-t border-rule px-5 py-8 text-sm text-quiet sm:px-8">
          <span>© {new Date().getFullYear()} Evan Springer</span>
          <a href={`mailto:${EMAIL}`} class="no-underline hover:text-ink">{EMAIL}</a>
        </footer>
      </>
    )}
  </body>
</html>
