---
import Base from '../layouts/Base.astro';
import { EMAIL, treeLinkFor } from '../data/tree';
---

<Base title="Contact — Evan Springer" back={treeLinkFor('/contact/')} plain>
  <article class="min-h-[55vh] pt-24 sm:pt-32">
    <h1 class="text-2xl font-medium tracking-[-0.02em]">Contact</h1>
    <p class="mt-10 max-w-[46ch] text-lg leading-relaxed text-quiet text-balance">
      Building an app or product and looking for a designer? Email me.
    </p>
    <a
      href={`mailto:${EMAIL}`}
      class="mt-6 inline-block text-xl font-medium tracking-[-0.01em] underline decoration-rule decoration-1 underline-offset-[6px] hover:decoration-ink sm:text-2xl"
    >{EMAIL}</a>
  </article>
</Base>
