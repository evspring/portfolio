---
import Base from '../layouts/Base.astro';
import FileTree from '../components/FileTree.astro';
---

<Base bare>
  <!-- The only chrome: who, where you are in the tree, and how many items are here -->
  <header class="pointer-events-none fixed inset-x-0 top-0 z-10 grid grid-cols-[1fr_auto_1fr] items-baseline gap-4 px-5 pt-6 text-[12.5px] sm:px-8">
    <h1 class="pointer-events-auto font-medium">
      Evan Springer<span class="hidden font-normal text-quiet sm:inline">, product designer</span>
    </h1>
    <nav class="tree-path pointer-events-auto text-quiet" aria-label="Current folder" data-path>evan</nav>
    <span></span>
  </header>
  <FileTree />
  <p class="fixed inset-x-0 bottom-5 text-center text-[12px] text-quiet" data-count aria-live="polite">Click the pot</p>
</Base>

<style is:global>
  .tree-path { display: flex; gap: 0.35em; }
  .tree-path button { color: var(--color-quiet); background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }
  .tree-path button:hover { color: var(--color-ink); }
  .tree-path [aria-current] { color: var(--color-ink); }
  .tree-path .sep { color: var(--color-rule); }
  html.js body { overflow: hidden; }
  html:not(.js) [data-path], html:not(.js) [data-count] { display: none; }
</style>
