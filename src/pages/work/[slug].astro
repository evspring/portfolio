---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LightStrip from '../../components/LightStrip.astro';
import { treeLinkFor } from '../../data/tree';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, client, role, year, status, award } = entry.data;
---

<Base title={`${title} — Evan Springer`} description={summary} back={treeLinkFor(`/work/${entry.id}/`)}>
  <article class="pt-24 sm:pt-32">
    <h1 class="text-2xl font-medium tracking-[-0.02em]">{title}</h1>
    <p class="mt-4 max-w-[52ch] text-lg leading-relaxed text-quiet">{summary}</p>

    {entry.id === 'sequence' && (
      <div class="mt-12 mb-4"><LightStrip /></div>
    )}

    <dl class="mt-10 grid max-w-[40rem] grid-cols-2 gap-y-4 text-sm sm:grid-cols-4">
      <div><dt class="text-quiet">Client</dt><dd>{client}</dd></div>
      <div><dt class="text-quiet">Role</dt><dd>{role}</dd></div>
      <div><dt class="text-quiet">Year</dt><dd>{year}</dd></div>
      {(status || award) && <div><dt class="text-quiet">Status</dt><dd>{status ?? award}</dd></div>}
    </dl>

    <div class="mt-14 grid aspect-[16/9] place-items-center rounded-(--radius-mat) bg-mat">
      <span class="text-sm text-quiet">{title} hero screen</span>
    </div>

    <div class="prose-case mt-16 max-w-[62ch]">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  .prose-case h2 { font-size: var(--text-lg); font-weight: 500; margin: 3rem 0 0.75rem; }
  .prose-case p, .prose-case li { font-size: var(--text-lg); line-height: 1.65; color: var(--color-ink); }
  .prose-case p + p { margin-top: 1rem; }
  .prose-case ul { list-style: disc; padding-left: 1.25rem; display: grid; gap: 0.5rem; }
</style>
